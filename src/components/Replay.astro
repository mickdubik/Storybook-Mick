---
// Replay button for an animated frame (as in Chrome's "What's new" previews). Ghost: just the icon, a soft fill on
// hover or keyboard focus, and a "Replay" pill under it in the same style. The parent positions it (corner of the
// frame) and wires the click. Hidden under reduced motion: the animation shows its still, so there is nothing to replay.
// With `pausable` it is a three-state control (set on `data-state` by the page): pause while it plays, play while it is
// paused, replay once it has finished.
interface Props {
  label: string;
  pausable?: boolean;
}
const { label, pausable = false } = Astro.props;
---

<button type="button" class="replay" aria-label={`Replay ${label}`} data-state={pausable ? "done" : undefined} data-label={label}>
  {pausable && <svg class="i-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><rect x="6.5" y="5" width="3.8" height="14" rx="1.3" fill="currentColor"/><rect x="13.7" y="5" width="3.8" height="14" rx="1.3" fill="currentColor"/></svg>}
  {pausable && <svg class="i-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M8.2 5.9v12.2a.9.9 0 0 0 1.38.76l9.5-6.1a.9.9 0 0 0 0-1.52l-9.5-6.1A.9.9 0 0 0 8.2 5.9z" fill="currentColor"/></svg>}
  <svg class="i-replay" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4.27 9.93A8 8 0 1 0 13.4 4.1" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M7.97 3.16L13.96 0.92L12.82 7.32z" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg>
  <span class="replay__hint mono" aria-hidden="true">Replay</span>
</button>

<style>
  .i-pause, .i-play { display: none; }
  .replay[data-state="playing"] .i-pause, .replay[data-state="paused"] .i-play { display: block; }
  .replay[data-state="playing"] .i-replay, .replay[data-state="paused"] .i-replay { display: none; }
  .replay {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 200ms ease;
  }
  .replay__hint {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding-inline: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    color: var(--ink);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 200ms ease, transform 200ms var(--ease-out);
  }
  .replay:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; background: color-mix(in srgb, var(--ink) 10%, transparent); }
  .replay:focus-visible .replay__hint { opacity: 1; transform: none; }
  @media (hover: hover) {
    .replay:hover { background: color-mix(in srgb, var(--ink) 10%, transparent); }
    .replay:hover .replay__hint { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .replay { display: none; } }
</style>
