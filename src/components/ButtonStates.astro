---
// One button walking through its states, as a quiet looping demo: default, hover, focus (the ring),
// pressed (the ring stays, as it does on a focused button), loading, then a confirmation, and back to default. No cursor: the button does the talking.
// Specs are read from the owner's Figma file (ExF | Design System, Buttons, Primary): fill #0077ff, hover
// #3395ff, pressed #0057b5, 36px high, 8/16 padding, 2px radius, bold label, outer 1px focus ring at a 3px
// radius, and a grey loading state (dark #141414 / light #cccccc with a stroke). The "Done" confirmation is
// NOT in the Figma sheet; it is added for the demo, and the caption says so.
// Button practice: the button never changes size between states (no layout shift), the label is bold and at
// least 18.7px so white on #0077ff meets the 3:1 large-text contrast, the press gets real feedback (darker
// fill and the focus ring, no change of size), the busy state is a spinner that replaces the label (same width, no shift; a real
// button would also set aria-busy and ignore clicks), and the loop is slow and
// eased. Only transform and opacity animate: colours are cross-faded layers. The loop runs only while it is
// on screen. Reduced motion: a still button.
interface Props {
  title: string;
  caption: string;
  /** Longer explanation that does not fit the 2-line caption: a paragraph under the frame. */
  note?: string;
}
import Replay from "./Replay.astro";
const { title, caption, note } = Astro.props;
const states = ["Default", "Hover", "Focus", "Pressed", "Loading", "Done"];
---

<div class="bs-wrap">
<figure class="bs">
  <Replay label="the button states" pausable />
  <div class="bs__stage" data-bs>
    <p class="sr-only">
      Animated demo of the primary button. It lightens on hover, shows a focus ring, darkens when pressed, switches to a loading state with a spinner in place of the label,
      then confirms with a check, and resets.
    </p>
    <div class="bs__demo" aria-hidden="true">
      <div class="bs__btn">
        <span class="bs__fill bs__fill--hover"></span>
        <span class="bs__fill bs__fill--press"></span>
        <span class="bs__fill bs__fill--load"></span>
        <span class="bs__ring"></span>
        <span class="bs__layer bs__layer--idle">
          <svg viewBox="0 0 16 16" class="bs__ico"><path d="M7 2h2v5h5v2H9v5H7V9H2V7h5z" fill="currentColor" /></svg>Button
        </span>
        <span class="bs__layer bs__layer--load">
          <svg viewBox="0 0 16 16" class="bs__ico bs__spin"><circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="26 9" stroke-linecap="round" /></svg>
        </span>
        <span class="bs__layer bs__layer--done">
          <svg viewBox="0 0 16 16" class="bs__ico"><path d="m3 8.5 3.2 3.2L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>Done
        </span>
      </div>
    </div>
    <ol class="bs__states mono" aria-hidden="true">
      {states.map((s, i) => <li class={`bs__s bs__s--${i + 1}`}>{s}</li>)}
    </ol>
  </div>
  <figcaption class="bs__caption"><strong class="bs__title">{title}.</strong> {caption}</figcaption>
</figure>
{note && <p class="bs__note">{note}</p>}
</div>

<script>
  import { bindCtl } from "../scripts/anim-control";
  // Plays once when the demo comes into view and rests (owner, 2026-11-12). One control pauses, resumes and replays it.
  document.querySelectorAll<HTMLElement>("[data-bs]").forEach((stage) => {
    const btn = stage.closest(".bs")?.querySelector<HTMLElement>(".replay");
    let visible = !("IntersectionObserver" in window), userPaused = false;
    const apply = () => { stage.dataset.on = visible && !userPaused ? "" : "off"; };
    apply();
    const ctl = bindCtl(btn, {
      pause: () => { userPaused = true; apply(); },
      resume: () => { userPaused = false; apply(); },
      restart: () => {
        // Clear the CSS animations, force a reflow, put them back.
        const parts = stage.querySelectorAll<HTMLElement>(".bs__demo *, .bs__s");
        parts.forEach((p) => (p.style.animation = "none"));
        void stage.offsetWidth;
        parts.forEach((p) => (p.style.animation = ""));
        userPaused = false; apply();
      },
    });
    // The idle label is the last layer to finish its 10 s run.
    stage.addEventListener("animationend", (e) => { if ((e.target as HTMLElement).classList.contains("bs__layer--idle")) ctl.set("done"); });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { visible = es[0].isIntersecting; apply(); }, { threshold: 0.35 }).observe(stage);
    }
  });
</script>

<style>
  .bs {
    --bs-inner: 10px;
    --bs-pad: var(--frame-pad);
    --bs-blue: #0077ff;
    --bs-blue-hover: #3395ff;
    --bs-blue-press: #0057b5;
    --bs-load-bg: #ccc;
    --bs-load-line: #a6a6a6;
    --bs-load-ink: #4d4d4d;
    position: relative;
    /* The frame of an animation (same as the animated screens): 16:9, the stage dead centre with the same inset all round, the
       caption (two lines at most) 12px under it, Replay in the top left corner. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    aspect-ratio: 16 / 9;
    width: 100%;
    padding: calc(var(--bs-pad) * 2.4) calc(var(--bs-pad) * 2);
    border-radius: var(--frame-radius);
    background: var(--paper-2);
  }
  .bs-wrap { container-type: inline-size; margin-top: 28px; }
  .bs__note { margin: 16px 0 0; padding-inline: var(--frame-radius); color: var(--ink-2); font-size: var(--t-small); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .bs { --bs-load-bg: #0c0c0b; --bs-load-line: #4a4945; --bs-load-ink: #b3b3b3; }
  }
  :global(:root[data-theme="dark"]) .bs { --bs-load-bg: #0c0c0b; --bs-load-line: #4a4945; --bs-load-ink: #b3b3b3; }

  .bs__stage {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4.5cqi, 48px);
    /* as tall as the frame allows (frame height minus the inset top and bottom; a little more at the bottom, for the two-line caption), 16:10 like the other screens, centred */
    width: min(100%, calc((56.25cqi - var(--bs-pad) * 4.8) * 1.6));
    aspect-ratio: 16 / 10;
    /* No inner panel: the button and its state legend sit straight on the frame's canvas (one box per figure, owner 2026-10-27). */
  }
  /* Sized in em from the Figma 14px, scaled up so the bold label is 18.7px or more. */
  .bs__demo { font-size: clamp(19px, 2.6vw, 23px); }
  /* Figma primary button at 14px: 36px high, 8px/16px padding, 4px between icon and label, 2px radius, 91px
     wide (it sizes to its content, 91px minimum). The other states sit on top of it and never change its size. */
  .bs__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 6.5em; /* 91 / 14 */
    min-height: 2.5714em; /* 36 / 14 */
    padding: 0.5714em 1.1429em; /* 8 / 14, 16 / 14 */
    border-radius: 0.1429em; /* 2 / 14 */
    background: var(--bs-blue);
    color: #fff;
    font: 700 1em/1.4286 var(--font-sans, system-ui, sans-serif); /* 20px line at 14px */
  }
  .bs__fill, .bs__ring { position: absolute; inset: 0; border-radius: inherit; opacity: 0; pointer-events: none; }
  .bs__fill--hover { background: var(--bs-blue-hover); }
  .bs__fill--press { background: var(--bs-blue-press); }
  .bs__fill--load { background: var(--bs-load-bg); box-shadow: inset 0 0 0 1px var(--bs-load-line); }
  /* Focus: a ring in the button blue with a gap of the same size as the ring (best practice: 2px ring, 2px offset at the real 14px size; a clear ring, not a button that looks bigger). The Figma sheet's ring hugs the
     button with no gap; on the dark canvas that reads as a size change, so the demo keeps a gap (owner, 2026-11-09). The button itself never changes size. */
  .bs__ring { inset: -0.24em; border: 0.12em solid var(--bs-blue); border-radius: 0.38em; } /* ring and gap equal (about 2px each at the real 14px size); radius = button radius + gap + ring, so it stays concentric */
  .bs__layer { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 0.2857em; white-space: nowrap; opacity: 0; }
  /* The resting layer is in the flow and gives the button its size; the others overlay it. */
  .bs__layer--idle { position: static; opacity: 1; }
  .bs__layer--load { color: var(--bs-load-ink); }
  .bs__ico { width: 0.9286em; height: 0.9286em; flex: none; } /* the Figma glyph is 13px at 14px */
  .bs__layer--load .bs__ico { width: 1.15em; height: 1.15em; }

  /* The state names are a quiet legend: small, low contrast, the current one only a touch brighter. */
  .bs__states { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px clamp(12px, 3vw, 22px); margin: 0; padding: 0; list-style: none; font-size: var(--t-micro); letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-3); }
  .bs__s { color: var(--ink-3); }


  .bs__caption { position: absolute; left: 0; right: 0; top: calc(100% - var(--bs-pad) * 2.4 + min(12px, var(--bs-pad) * 0.45)); margin: 0; padding-inline: calc(var(--bs-pad) * 2); text-align: center; color: var(--ink-2); font-size: var(--t-small); line-height: 1.35; }
  /* Narrow frames (phones): no fixed ratio; stage, caption stack. */
  @container (max-width: 559px) {
    .bs { aspect-ratio: auto; justify-content: flex-start; padding: var(--bs-pad); }
    .bs__stage { width: 100%; aspect-ratio: auto; padding: 56px 12px 24px; }
    .bs__caption { position: static; margin-top: 12px; padding-inline: 0; text-align: left; }
  }
  .bs__title { color: var(--ink); font-weight: 500; }

  /* Loop: 10s, eased. Default 0–14%, hover 14–30%, focus 31–42%, pressed 43–55%, loading 56–76%, done 76–95%, reset. */
  @media (prefers-reduced-motion: no-preference) {
    .bs__demo *, .bs__s { animation-duration: 10s; animation-iteration-count: 1; animation-fill-mode: both; animation-timing-function: ease-in-out; } /* one run, then it rests (owner, 2026-11-12) */
    /* Off screen: the script sets data-on="off" and everything pauses. Without the script it just runs. */
    .bs__stage[data-on="off"] *, .bs__stage[data-on="off"] .bs__s { animation-play-state: paused; }
    /* Keeps looping under the pointer (owner, 2026-10-23): it no longer holds still on hover or focus. It still pauses off screen. */

    .bs__fill--hover { animation-name: bs-hover; }
    .bs__fill--press { animation-name: bs-press-fill; }
    .bs__ring { animation-name: bs-ring; }
    .bs__fill--load { animation-name: bs-load; }
    .bs__layer--idle { animation-name: bs-idle; }
    .bs__layer--load { animation-name: bs-loadlbl; }
    .bs__layer--done { animation-name: bs-done; }
    .bs__spin { animation-name: bs-spin; animation-duration: 0.9s; animation-timing-function: linear; animation-iteration-count: infinite; } /* the spinner turns for as long as the loading label shows */

    .bs__s--1 { animation-name: bs-s1; }
    .bs__s--2 { animation-name: bs-s2; }
    .bs__s--3 { animation-name: bs-s3; }
    .bs__s--4 { animation-name: bs-s4; }
    .bs__s--5 { animation-name: bs-s5; }
    .bs__s--6 { animation-name: bs-s6; }

    /* Crossfades: the outgoing fill stays at full opacity under the incoming one until that one is fully in, so the base blue never shows through between states. */
    @keyframes bs-hover { 0%, 12% { opacity: 0 } 17%, 27% { opacity: 1 } 31%, 100% { opacity: 0 } }
    @keyframes bs-press-fill { 0%, 39% { opacity: 0 } 43%, 59% { opacity: 1 } 60%, 100% { opacity: 0 } }
    @keyframes bs-ring { 0%, 30% { opacity: 0 } 34%, 53% { opacity: 1 } 57%, 100% { opacity: 0 } }
    @keyframes bs-load { 0%, 52% { opacity: 0 } 58%, 74% { opacity: 1 } 80%, 100% { opacity: 0 } }
    @keyframes bs-idle { 0%, 51% { opacity: 1 } 57%, 91% { opacity: 0 } 97%, 100% { opacity: 1 } }
    @keyframes bs-loadlbl { 0%, 51% { opacity: 0 } 58%, 73% { opacity: 1 } 78%, 100% { opacity: 0 } }
    @keyframes bs-done { 0%, 75% { opacity: 0 } 81%, 92% { opacity: 1 } 96%, 100% { opacity: 0 } }
    @keyframes bs-spin { to { transform: rotate(360deg) } }
    @keyframes bs-s1 { 0%, 12% { color: var(--ink) } 16%, 94% { color: var(--ink-3) } 98%, 100% { color: var(--ink) } }
    @keyframes bs-s2 { 0%, 12% { color: var(--ink-3) } 17%, 27% { color: var(--ink) } 31%, 100% { color: var(--ink-3) } }
    @keyframes bs-s3 { 0%, 31% { color: var(--ink-3) } 35%, 39% { color: var(--ink) } 43%, 100% { color: var(--ink-3) } }
    @keyframes bs-s4 { 0%, 43% { color: var(--ink-3) } 47%, 54% { color: var(--ink) } 58%, 100% { color: var(--ink-3) } }
    @keyframes bs-s5 { 0%, 57% { color: var(--ink-3) } 61%, 73% { color: var(--ink) } 77%, 100% { color: var(--ink-3) } }
    @keyframes bs-s6 { 0%, 78% { color: var(--ink-3) } 82%, 92% { color: var(--ink) } 96%, 100% { color: var(--ink-3) } }
  }
  @media (prefers-reduced-motion: reduce) {
    .bs__s--1 { color: var(--ink); }
  }
</style>
