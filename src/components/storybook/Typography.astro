---
import { declared } from "./tokens";
const scale = declared("t-");
---

<div class="scale">
  {scale.map((t) => (
    <div class="row">
      <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
      <div class="sample" style={`font-size:var(--${t.name})`}>Outcome first</div>
      {t.note && <p class="note">{t.note}</p>}
    </div>
  ))}
  <div class="row">
    <div class="meta"><code>--font-sans</code><span>Geist Variable</span></div>
    <div class="sample" style="font-family:var(--font-sans);font-size:var(--t-h3);font-weight:600">The quick brown fox</div>
  </div>
  <div class="row">
    <div class="meta"><code>--font-mono</code><span>Geist Mono Variable</span></div>
    <div class="sample" style="font-family:var(--font-mono);font-size:var(--t-small);text-transform:uppercase;letter-spacing:0.06em">Meta label</div>
  </div>
</div>

<style>
  .scale { color: var(--ink); }
  .row { display: grid; grid-template-columns: 220px 1fr; gap: 8px 24px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .meta { display: grid; gap: 2px; }
  code { font-family: var(--font-mono); font-size: var(--t-small); }
  .meta span { color: var(--ink-3); font-size: var(--t-micro); word-break: break-word; }
  .sample { font-family: var(--font-sans); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; overflow-wrap: anywhere; }
  .note { grid-column: 2; margin: 0; color: var(--ink-3); font-size: var(--t-small); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .note { grid-column: 1; } }
</style>
