---
import { declared } from "./tokens";
// Facts: rules/visual.md (Layout) and src/styles/global.css. The diagram uses the real .wrap, .sheet, .rail and .body classes.
const spacing = ["layout-padding-x", "space-gutter", "space-column-gap", "space-section", "space-block", "space-group", "space-tile"]
  .map((n) => declared("").find((t) => t.name === n))
  .filter((t): t is NonNullable<typeof t> => !!t);
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

---

<div class="ds-page">
  <h1>Layout</h1>
  <p>Every page sits in one wrapper and, where it has a section label, one 12-column sheet. Below 960px everything stacks. Every page must work at phone width with no horizontal scroll.</p>
  <nav aria-label="On this page">
    <ul class="ds-chips">
      {[{ t: "The wrapper" }, { t: "The sheet" }, { t: "Lists" }, { t: "Spacing tokens", n: spacing.length }].map((c) => <li><a href={`#${id(c.t)}`}>{c.t}{c.n !== undefined && <> <strong>{c.n}</strong></>}</a></li>)}
    </ul>
  </nav>

  <h2 id="the-wrapper">The wrapper: <code>.wrap</code></h2>
  <p>
    No maximum width. Its side padding is the page margin <code>--layout-padding-x</code>: 72px at 1440, scaling to 96px at 1920, and centred beyond 1920. It is the same on every page, header and footer included.
  </p>

  <h2 id="the-sheet">The sheet: <code>.sheet</code></h2>
  <p>
    Twelve columns from 960px. The <b>rail</b> (columns 1 to 3) holds the sticky section label or a case table of contents. The <b>body</b> (columns 4 to 12) holds the content. Below 960px the rail and body stack.
  </p>

  <div class="demo wrap" aria-label="Diagram of the 12-column sheet: a rail over columns 1 to 3 and a body over columns 4 to 12">
    <div class="cols" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
    </div>
    <div class="sheet">
      <div class="rail"><i>Rail</i><small>Columns 1–3</small></div>
      <div class="body"><i>Body</i><small>Columns 4–12</small></div>
    </div>
  </div>

  <h2 id="lists">Lists</h2>
  <p>Lists are ruled tables, not cards. Sections divide by hairlines, and inset surfaces step one tone off the page (<code>--color-background-subtle</code>).</p>

  <h2 id="spacing-tokens">Spacing tokens</h2>
  <p>The values below are read from <code>global.css</code>. See <a href="?path=/story/foundations-space-and-shape--space-and-shape">Space and shape</a> for each one drawn to scale.</p>
  <table>
    <thead><tr><th>Token</th><th>Value</th></tr></thead>
    <tbody>
      {spacing.map((t) => <tr><td><code>--{t.name}</code></td><td><code>{t.value}</code></td></tr>)}
    </tbody>
  </table>

  <h2 id="read-next">Read next</h2>
  <ul>
    <li><a href="?path=/story/foundations-motion--durations">Motion</a>: the duration and easing tokens, and how reduced motion is handled.</li>
    <li><a href="?path=/story/foundations-space-and-shape--space-and-shape">Space and shape</a>: each spacing token drawn to scale.</li>
  </ul>
</div>

<style>
  .demo { margin: 24px 0 0; padding-inline: 0; position: relative; }
  .cols { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-column-gap); pointer-events: none; }
  .cols span { background: color-mix(in srgb, var(--color-accent) 6%, transparent); font-family: var(--font-family-mono); font-size: var(--font-size-micro); color: var(--color-text-muted); text-align: center; padding-top: 4px; }
  .sheet { position: relative; padding-top: 28px; min-height: 120px; }
  .rail, .body { background: var(--color-background-subtle); box-shadow: inset 0 0 0 1px var(--color-border-default); padding: 12px; display: grid; gap: 2px; align-content: start; min-height: 72px; }
  .rail i, .body i { font-style: normal; font-weight: 600; color: var(--color-text-default); }
  small { color: var(--color-text-muted); font-family: var(--font-family-mono); font-size: var(--font-size-micro); }
  table { margin-top: 16px; }
  th:nth-child(1) { width: 40%; }
</style>
