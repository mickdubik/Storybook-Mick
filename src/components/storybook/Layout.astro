---
import { declared } from "./tokens";
// Facts: rules/visual.md (Layout) and src/styles/global.css. The diagram uses the real .wrap, .sheet, .rail and .body classes.
const spacing = ["pad-x", "gutter", "col-gap", "section", "space-block", "space-group", "space-tile"]
  .map((n) => declared("").find((t) => t.name === n))
  .filter((t): t is NonNullable<typeof t> => !!t);
---

<div class="lay">
  <h1 class="title">Layout</h1>
  <p class="lead">
    Every page sits in one wrapper and, where it has a section label, one 12-column sheet. Below 960px everything stacks. Every page must work at phone width with no horizontal scroll.
  </p>

  <h3>The wrapper: <code>.wrap</code></h3>
  <p>
    No maximum width. Its side padding is the page margin <code>--pad-x</code>: 72px at 1440, scaling to 96px at 1920, and centred beyond 1920. It is the same on every page, header and footer included.
  </p>

  <h3>The sheet: <code>.sheet</code></h3>
  <p>
    Twelve columns from 960px. The <b>rail</b> (columns 1 to 3) holds the sticky section label or a case table of contents. The <b>body</b> (columns 4 to 12) holds the content. Below 960px the rail and body stack.
  </p>

  <div class="demo wrap" aria-label="Diagram of the 12-column sheet: a rail over columns 1 to 3 and a body over columns 4 to 12">
    <div class="cols" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}
    </div>
    <div class="sheet">
      <div class="rail"><i>Rail</i><small>Columns 1–3</small></div>
      <div class="body"><i>Body</i><small>Columns 4–12</small></div>
    </div>
  </div>

  <h3>Lists</h3>
  <p>Lists are ruled tables, not cards. Sections divide by hairlines, and inset surfaces step one tone off the page (<code>--paper-2</code>).</p>

  <h3>Spacing tokens</h3>
  <p>The values below are read from <code>global.css</code>. See Space and shape for each one drawn to scale.</p>
  <table>
    <thead><tr><th>Token</th><th>Value</th></tr></thead>
    <tbody>
      {spacing.map((t) => <tr><td><code>--{t.name}</code></td><td><code>{t.value}</code></td></tr>)}
    </tbody>
  </table>
</div>

<style>
  .title { margin: 0 0 12px; font-size: var(--t-h3); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; color: var(--ink); }
  .lay { color: var(--ink); max-width: 900px; }
  .lead { font-size: var(--t-body); line-height: 1.5; color: var(--ink-2); max-width: var(--measure); margin: 0 0 8px; }
  h3 { font-family: var(--font-sans); font-weight: 600; font-size: var(--t-lede); margin: 40px 0 4px; }
  p { font-size: var(--t-small); line-height: 1.55; color: var(--ink-2); margin: 0; max-width: var(--measure); }
  .lead { font-size: var(--t-body); }
  code { font-family: var(--font-mono); font-size: 0.85em; }
  .demo { margin-top: 20px; padding-inline: 0; position: relative; }
  .cols { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--col-gap); pointer-events: none; }
  .cols span { background: color-mix(in srgb, var(--signal) 6%, transparent); font-family: var(--font-mono); font-size: var(--t-micro); color: var(--ink-3); text-align: center; padding-top: 4px; }
  .sheet { position: relative; padding-top: 28px; min-height: 120px; }
  .rail, .body { background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--rule); padding: 12px; display: grid; gap: 2px; align-content: start; min-height: 72px; }
  .rail i, .body i { font-style: normal; font-weight: 600; }
  small { color: var(--ink-3); font-family: var(--font-mono); font-size: var(--t-micro); }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: var(--t-small); }
  th { text-align: left; color: var(--ink-3); font-weight: 500; padding: 8px 12px 8px 0; border-bottom: 1px solid var(--rule); }
  td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--rule); }
</style>
