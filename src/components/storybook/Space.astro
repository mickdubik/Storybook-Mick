---
import { declared } from "./tokens";
const names = ["gutter", "col-gap", "section", "space-tile", "space-block", "space-group", "frame-pad", "frame-radius", "measure", "radius"];
const all = declared("");
const items = names.map((n) => all.find((t) => t.name === n)).filter((t): t is NonNullable<typeof t> => !!t);
---

<div class="space">
  {items.map((t) => (
    <div class="row">
      <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
      <div class="bar" style={t.name === "frame-radius" || t.name === "radius" ? `width:96px;height:48px;border-radius:var(--${t.name})` : `width:var(--${t.name})`}></div>
      {t.note && <p class="note">{t.note}</p>}
    </div>
  ))}
</div>

<style>
  .space { color: var(--ink); }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 8px 24px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .meta { display: grid; gap: 2px; }
  code { font-family: var(--font-mono); font-size: var(--t-small); }
  .meta span { color: var(--ink-3); font-size: var(--t-micro); word-break: break-word; }
  .bar { height: 12px; max-width: 100%; background: var(--paper-3); box-shadow: inset 0 0 0 1px var(--rule); }
  .note { grid-column: 2; margin: 0; color: var(--ink-3); font-size: var(--t-small); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .note { grid-column: 1; } }
</style>
