---
import { declared } from "./tokens";
const all = declared("");
const pick = (names: string[]) => names.map((n) => all.find((t) => t.name === n)).filter((t): t is NonNullable<typeof t> => !!t);
const job: Record<string, string> = {
  gutter: "Page gutter",
  "col-gap": "Gap between columns",
  section: "Padding of a section",
  "space-tile": "Gap between tiles of one grid",
  "space-block": "Between blocks inside a section or chapter",
  "space-group": "Heading to content, label to value",
  "frame-pad": "Inset of the screen inside a media frame",
  measure: "Reading line length, about 66 characters",
};
const spacing = pick(["gutter", "col-gap", "section", "space-tile", "space-block", "space-group", "frame-pad", "measure"]);
const radii = pick(["radius", "btn-r", "frame-radius"]);
---

<div class="space">
  <h1 class="title">Space and shape</h1>
  <p class="intro">Spacing steps are named for the job they do, not for a number. Pick the step that matches the gap you are making, so two designers never choose values one pixel apart.</p>

  <section>
    <h3>Spacing</h3>
    <p class="why">A bar is as wide as the token. Fluid tokens use <code>clamp()</code>, so the bar shown is the value at this window width.</p>
    {spacing.map((t) => (
      <div class="row">
        <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
        <div class="bar" style={`width:var(--${t.name})`}></div>
        {job[t.name] && <p class="note">{job[t.name]}</p>}
      </div>
    ))}
  </section>

  <section>
    <h3>Radius</h3>
    <p class="why">Small corners on the page, rounder ones on the frames that hold media. An inner corner is the outer radius minus the gap between them.</p>
    <div class="radii">
      {radii.map((t) => (
        <div class="r">
          <div class="shape" style={`border-radius:var(--${t.name})`}></div>
          <code>--{t.name}</code>
          <span>{t.value}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h3>Elevation</h3>
    <p class="why">None. There are no card shadows. Sections divide by hairlines, and an inset surface steps one tone off the page with <code>--paper-2</code>.</p>
    <div class="elev">
      <div class="page"><div class="inset">--paper-2</div><span>--paper</span></div>
    </div>
  </section>
</div>

<style>
  .space { color: var(--ink); display: grid; gap: 40px; }
  .title { margin: 0 0 -24px; font-size: var(--t-h3); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .intro { margin: 0; max-width: var(--measure); font-size: var(--t-body); color: var(--ink-2); }
  h3 { margin: 0 0 4px; font-size: var(--t-lede); font-weight: 600; }
  .why { margin: 0 0 8px; max-width: var(--measure); color: var(--ink-2); font-size: var(--t-small); }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 8px 24px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .meta { display: grid; gap: 2px; }
  code { font-family: var(--font-mono); font-size: var(--t-small); }
  .meta span { color: var(--ink-3); font-size: var(--t-micro); word-break: break-word; }
  .bar { height: 12px; max-width: 100%; background: var(--paper-3); box-shadow: inset 0 0 0 1px var(--rule); }
  .note { grid-column: 2; margin: 0; color: var(--ink-3); font-size: var(--t-small); }
  .radii { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 12px; }
  .r { display: grid; gap: 4px; justify-items: start; }
  .r span { color: var(--ink-3); font-size: var(--t-micro); }
  .shape { width: 120px; height: 80px; background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--rule); }
  .elev { margin-top: 12px; }
  .page { display: grid; gap: 8px; padding: 24px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--rule); max-width: 360px; }
  .page span { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--ink-3); }
  .inset { padding: 24px; background: var(--paper-2); font-family: var(--font-mono); font-size: var(--t-micro); color: var(--ink-3); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; } .note { grid-column: 1; } }
</style>
