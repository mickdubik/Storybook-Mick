---
import TokenTable from "./TokenTable.astro";
const { view = "overview" } = Astro.props as { view?: "overview" | "tokens" };
import { declared } from "./tokens";
const all = declared("");
const get = (n: string) => all.find((t) => t.name === n);
const durations = ["duration-default", "btn-duration"].map(get).filter((t): t is NonNullable<typeof t> => !!t);
const easings = ["easing-out", "btn-easing"].map(get).filter((t): t is NonNullable<typeof t> => !!t);
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

---

{view === "tokens" ? <TokenTable area="Motion" /> : (
<div class="ds-page" data-motion>
  <h1>Motion</h1>
  <p>Two timings and two curves, one pair for the page and one for the button. Everything that moves animates transform and opacity only, never width, height, padding or margin.</p>

  <nav aria-label="On this page">
    <ul class="ds-chips">
      {[{ t: "Try it", n: durations.length }, { t: "Easing", n: easings.length }, { t: "Reduced motion" }].map((c) => <li><a href={`#${id(c.t)}`}>{c.t}{c.n !== undefined && <> <strong>{c.n}</strong></>}</a></li>)}
    </ul>
  </nav>

  <section>
    <h2 id="try-it">Try it</h2>
    <p>Press the button to play every track. The dot travels at the token's own duration.</p>
    <button type="button" class="play" data-play>Move</button>
    {durations.map((t) => (
      <div class="row">
        <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
        <div class="track"><i style={`transition-duration:var(--${t.name})`}></i></div>
      </div>
    ))}
  </section>

  <section>
    <h2 id="easing">Easing</h2>
    <p>Both curves start quickly and settle, which reads as responsive rather than floaty. The tracks run slowed to 1.2 s so the curve is visible.</p>
    {easings.map((t) => (
      <div class="row">
        <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
        <div class="track"><i style={`transition-timing-function:var(--${t.name});transition-duration:1200ms`}></i></div>
      </div>
    ))}
  </section>

  <section>
    <h2 id="reduced-motion">Reduced motion</h2>
    <p>Everything that moves sits inside <code>prefers-reduced-motion: no-preference</code>. With reduced motion on, the same end state shows at once, or a defined still. Motion is a preference, not a decoration. Set it in your system accessibility settings and replay the demos to see it.</p>
  </section>

  <h2 id="read-next">Read next</h2>
  <ul>
    <li><a href="?path=/docs/components-button-variants--docs">Button</a>: the button's own duration and easing in use.</li>
    <li><a href="?path=/story/demos-smarttraffic--framed">Demos</a>: the animated case covers, made from the same tokens.</li>
  </ul>
</div>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-motion]").forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>("[data-play]");
    btn?.addEventListener("click", () => {
      root.toggleAttribute("data-on");
    });
  });
</script>

<style>
  .play { font: inherit; font-weight: 600; font-size: var(--font-size-small); padding: 10px 20px; border-radius: 999px; border: 0; background: var(--color-text-default); color: var(--color-background-default); cursor: pointer; margin: 0 0 8px; }
  .play:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 24px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--color-border-default); }
  .meta { display: grid; gap: 4px; }
  .meta code { font-family: var(--font-family-mono); font-size: var(--font-size-small); color: var(--color-text-default); }
  .meta span { color: var(--color-text-muted); font-size: var(--font-size-label); word-break: break-word; }
  .track { height: 24px; background: var(--color-background-subtle); box-shadow: inset 0 0 0 1px var(--color-border-default); border-radius: 12px; padding: 4px; }
  .track i { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--color-text-default); transform: translateX(0); transition-property: transform; transition-timing-function: var(--easing-out); }
  [data-on] .track i { transform: translateX(calc(min(100vw, 900px) - 480px)); }
  @media (prefers-reduced-motion: reduce) { .track i { transition-duration: 0s !important; } }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 8px; } [data-on] .track i { transform: translateX(calc(100vw - 120px)); } }
</style>
