---
import { declared } from "./tokens";
const all = declared("");
const items = ["dur", "ease-out", "btn-dur", "btn-ease"].map((n) => all.find((t) => t.name === n)).filter((t): t is NonNullable<typeof t> => !!t);
---

<p class="hint">Hover a row to play it. Only transform animates; reduced motion shows the end state at once.</p>
<div class="motion">
  {items.map((t) => (
    <div class="row">
      <div class="meta"><code>--{t.name}</code><span>{t.value}</span></div>
      {t.name.endsWith("dur") ? (
        <div class="track"><i style={`transition-duration:var(--${t.name})`}></i></div>
      ) : (
        <div class="track"><i style={`transition-timing-function:var(--${t.name});transition-duration:1200ms`}></i></div>
      )}
    </div>
  ))}
</div>

<style>
  .motion { color: var(--ink); }
  .hint { color: var(--ink-3); font-size: var(--t-small); margin: 0 0 12px; }
  .row { display: grid; grid-template-columns: 240px 1fr; gap: 24px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .meta { display: grid; gap: 2px; }
  code { font-family: var(--font-mono); font-size: var(--t-small); }
  .meta span { color: var(--ink-3); font-size: var(--t-micro); word-break: break-word; }
  .track { height: 24px; background: var(--paper-2); box-shadow: inset 0 0 0 1px var(--rule); border-radius: 12px; padding: 4px; }
  .track i { display: block; width: 16px; height: 16px; border-radius: 50%; background: var(--ink); transform: translateX(0); transition-property: transform; transition-timing-function: var(--ease-out); }
  .row:hover .track i { transform: translateX(calc(min(100vw, 900px) - 480px)); }
  @media (prefers-reduced-motion: reduce) { .track i { transition-duration: 0s !important; } }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr; gap: 8px; } .row:hover .track i { transform: translateX(calc(100vw - 120px)); } }
</style>
