---
import { declared, light, dark } from "./tokens";

// Every custom property the system defines, by tier: global (raw scales), semantic (colour roles), component (one component's own).
const semantic = ["color-background-default", "color-background-subtle", "color-background-muted", "color-text-default", "color-text-secondary", "color-text-muted", "color-border-default", "color-border-strong", "color-accent", "color-accent-inverse", "color-accent-subtle", "color-text-on-accent", "hero-glow", "hero-lite-a", "hero-lite-b", "color-background-card"];
const global = ["font-family-sans", "font-family-mono", "font-size-display", "font-size-h1", "font-size-h2", "font-size-h3", "font-size-figure", "font-size-figure-sm", "font-size-lede", "font-size-body", "font-size-small", "font-size-label", "font-size-micro", "space-gutter", "space-column-gap", "space-section", "space-tile", "space-block", "space-group", "size-measure", "size-measure-prose", "size-max", "radius-default", "duration-default", "easing-out", "unit-width", "unit", "layout-edge", "layout-padding-x"];
const component = ["btn-radius", "btn-inset", "btn-tile-size", "btn-duration", "btn-easing", "btn-background", "btn-background-hover", "btn-text", "btn-text-hover", "btn-tile-background", "btn-tile-background-hover", "btn-glyph-color", "btn-glyph-color-hover", "frame-padding", "frame-radius"];

const group = (n: string) =>
  /^font-/.test(n) ? "Type"
  : /^color-|^hero-/.test(n) ? "Colour"
  : /^(duration|easing|btn-duration|btn-easing)/.test(n) ? "Motion"
  : /^btn-/.test(n) ? "Button"
  : /^frame/.test(n) ? "Frame"
  : "Space and layout";

const find = (n: string) => declared("").find((d) => d.name === n);
const tiers = [
  {
    title: "Global",
    desc: "Raw scales with no role. Components may use these directly.",
    rows: global,
  },
  {
    title: "Semantic",
    desc: "Colour roles that say what a colour is for. Components use these and only these for colour. Dark mode redefines the same names.",
    rows: semantic,
  },
  {
    title: "Component",
    desc: "Tokens that belong to one component. Where they take a colour they point back at a semantic token.",
    rows: component,
  },
].map((t) => ({
  ...t,
  rows: t.rows.map((n) => ({ n, group: group(n), value: light[n] ?? find(n)?.value ?? "", dk: dark[n] })).filter((r) => r.value),
}));
const total = tiers.reduce((sum, t) => sum + t.rows.length, 0);
---

<div class="tok">
  <h1 class="title">Tokens</h1>
  <p class="intro">Every token in <code>src/styles/global.css</code>, {total} in all, by tier. Change a value there, never in a page or a component. A token's name stays fixed; its value may change with the theme or the window width.</p>
  {tiers.map((t) => (
    <section>
      <h3>{t.title} <span class="count">{t.rows.length}</span></h3>
      <p class="why">{t.desc}</p>
      <table class={t.title === "Semantic" ? "has-dark" : ""}>
        <thead><tr><th>Token</th><th>Group</th><th>Value</th>{t.title === "Semantic" && <th>Dark</th>}</tr></thead>
        <tbody>
          {t.rows.map((r) => (
            <tr>
              <td><code>--{r.n}</code></td>
              <td>{r.group}</td>
              <td>{/^#/.test(r.value) && <span class="sw" style={`background:${r.value}`}></span>}<code>{r.value}</code></td>
              {t.title === "Semantic" && <td>{r.dk ? <><span class="sw" style={`background:${r.dk}`}></span><code>{r.dk}</code></> : <span class="same">same</span>}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>

<style>
  .tok { color: var(--color-text-default); display: grid; gap: 40px; }
  .title { margin: 0 0 -24px; font-size: var(--font-size-h3); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .intro { margin: 0; max-width: var(--size-measure); font-size: var(--font-size-body); color: var(--color-text-secondary); }
  h3 { margin: 0 0 4px; font-size: var(--font-size-lede); font-weight: 600; }
  .count { color: var(--color-text-muted); font-weight: 400; font-size: var(--font-size-small); margin-left: 6px; }
  .why { margin: 0 0 8px; max-width: var(--size-measure); color: var(--color-text-secondary); font-size: var(--font-size-small); }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: var(--font-size-small); }
  /* Fixed columns: with auto layout the one long value (a color-mix() string) made the Value column far wider than the rest. */
  th:nth-child(1) { width: 26%; }
  th:nth-child(2) { width: 18%; }
  .has-dark th:nth-child(4) { width: 22%; }
  th { text-align: left; font-weight: 500; color: var(--color-text-muted); padding: 8px 12px 8px 0; border-bottom: 1px solid var(--color-border-default); }
  td { padding: 8px 12px 8px 0; border-bottom: 1px solid var(--color-border-default); vertical-align: middle; overflow-wrap: anywhere; }
  code { font-family: var(--font-family-mono); font-size: var(--font-size-small); }
  .sw { display: inline-block; width: 20px; height: 20px; border-radius: 5px; box-shadow: inset 0 0 0 1px var(--color-border-strong, var(--color-border-default)); vertical-align: middle; margin-right: 8px; }
  .same { color: var(--color-text-muted); }
</style>
