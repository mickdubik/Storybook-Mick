---
import { tiers, total } from "./tokenTiers";
---

<div class="ds-page">
  <h1>Tokens</h1>
  <p>Every token in <code>src/styles/global.css</code>, {total} in all, by tier. Change a value there, never in a page or a component. A token's name stays fixed; its value may change with the theme or the window width.</p>

  <nav aria-label="On this page">
  <ul class="ds-chips">
    {tiers.map((t) => <li><a href={`#${t.title.toLowerCase()}`}>{t.title} <strong>{t.rows.length}</strong></a></li>)}
  </ul>
  </nav>

  <h2>The three tiers</h2>
  <p>Read in this order, from raw to specific. Each tier builds on the one before.</p>
  <div class="ds-cards">
    {tiers.map((t, i) => (
      <a class="ds-card" href={`#${t.title.toLowerCase()}`}>
        <p class="ds-card__n">{String(i + 1).padStart(2, "0")}</p>
        <p class="ds-card__t">{t.title}</p>
        <p class="ds-card__d">{t.desc}</p>
        <span class="ds-card__go">{t.rows.length} tokens →</span>
      </a>
    ))}
  </div>

  {tiers.map((t) => (
    <section>
      <h2 id={t.title.toLowerCase()}>{t.title}</h2>
      <p>{t.desc}</p>
      <table class="ds-tokens">
        <thead>
          <tr>
            <th>Token</th>
            <th>Group</th>
            <th>{t.title === "Semantic" ? "Light" : "Value"}</th>
            {t.title === "Semantic" && <th>Dark</th>}
          </tr>
        </thead>
        <tbody>
          {t.rows.map((r) => (
            <tr>
              <td><code>--{r.n}</code></td>
              <td>{r.group}</td>
              <td>
                {/^#/.test(r.value) && <span class="ds-sw" style={`background:${r.value}`}></span>}
                <code>{r.value}</code>
              </td>
              {t.title === "Semantic" && (
                <td>
                  {r.dk ? (<>{/^#/.test(r.dk) && <span class="ds-sw" style={`background:${r.dk}`}></span>}<code>{r.dk}</code></>) : <span class="ds-same">same</span>}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <h2 id="read-next">Read next</h2>
  <ul>
    <li><a href="?path=/story/foundations-colour--semantic">Colour</a>: the roles these tokens fill, with their contrast.</li>
    <li><a href="?path=/docs/getting-started--docs">Getting started</a>: how the three tiers fit together and why they are layered.</li>
  </ul>
</div>
