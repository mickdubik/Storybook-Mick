---
import { light, dark, ratio, grade, declared, lum } from "./tokens";
import TokenTable from "./TokenTable.astro";

// "semantic" shows the roles, grouped by what they are for. "primitives" shows the raw values behind them.
const { view = "semantic" } = Astro.props as { view?: "semantic" | "primitives" | "tokens" };

// Roles are the owner's, copied from src/pages/system.astro. Other notes come from the comments in global.css.
const roles: Record<string, string> = {
  "color-background-default": "Page background",
  "color-background-subtle": "Inset panels: frames, plates, cards",
  "color-background-muted": "Glyph tracks, wireframe fills",
  "color-background-card": "Hero card and card surfaces: one tone off the page in light, the page itself in dark",
  "color-text-default": "Primary text, primary button",
  "color-text-secondary": "Body and secondary copy",
  "color-text-muted": "Meta labels",
  "color-border-default": "Hairlines",
  "color-border-strong": "Section-opening rules, the same value as the primary text",
  "color-accent": "Results and interactive states only",
  "color-text-on-accent": "Text on an accent fill: selection, the accent button label. The same value as the page background",
};
const levelClass = (g: string) => (g === "AAA" ? "aaa" : g === "AA" ? "aa" : g === "AA large" ? "large" : "low");
const noteOf = (n: string) => declared(n).find((d) => d.name === n)?.note ?? "";
const text = new Set(["color-text-default", "color-text-secondary", "color-text-muted", "color-accent"]);
const darkOf = (n: string) => dark[n] ?? light[n];

const groupBlurb: Record<string, string> = {
  Surfaces: "Backgrounds, from the page to the panels that sit on it. Each step is one tone off the page. There are no shadows.",
  Text: "Ink for copy, from primary to meta labels, with the second tone in headings set in the secondary ink.",
  Lines: "Hairlines that divide sections. The soft one separates rows, the strong one opens a section.",
  Accent: "The one accent. It marks a result or an interactive state, never a large fill. Text on an accent fill uses the on-accent token. The inverse is the other theme's accent.",
};
const groups = [
  { title: "Surfaces", names: ["color-background-default", "color-background-subtle", "color-background-muted", "color-background-card"] },
  { title: "Text", names: ["color-text-default", "color-text-secondary", "color-text-muted"] },
  { title: "Lines", names: ["color-border-default", "color-border-strong"] },
  { title: "Accent", names: ["color-accent", "color-accent-inverse", "color-text-on-accent"] },
].map((g) => ({
  title: g.title,
  rows: g.names.filter((n) => light[n]).map((n) => ({
    n,
    role: roles[n] ?? noteOf(n).replace(/^[a-z]/, (c) => c.toUpperCase()),
    l: light[n],
    d: darkOf(n),
    lr: text.has(n) ? ratio(light[n], light["color-background-default"]) : null,
    dr: text.has(n) ? ratio(darkOf(n), darkOf("color-background-default")) : null,
  })),
}));

const states = ["btn-background", "btn-background-hover", "btn-text", "btn-text-hover", "btn-tile-background", "btn-tile-background-hover", "btn-glyph-color", "btn-glyph-color-hover"]
  .map((n) => declared("btn-").find((d) => d.name === n))
  .filter((t): t is NonNullable<typeof t> => !!t);

// Primitives: every distinct hex value in the two themes, lightest first, with the roles that use it.
const used = new Map<string, { light: string[]; dark: string[] }>();
const add = (hex: string, theme: "light" | "dark", n: string) => {
  const e = used.get(hex) ?? { light: [], dark: [] };
  e[theme].push(n);
  used.set(hex, e);
};
for (const n of Object.keys(light)) add(light[n], "light", n);
for (const n of Object.keys(light)) add(darkOf(n), "dark", n);
const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
const family = (h: string) => {
  const [r, g, b] = rgb(h);
  return b - Math.max(r, g) > 60 ? "Cobalt" : "Neutral";
};
const order = ["Neutral", "Cobalt"];
const blurb: Record<string, string> = {
  Neutral: "Every grey in both themes, from white to near black. All carry the same slight cool cast, so the light and dark themes read as one family.",
  Cobalt: "The one blue, in a light and a deep value.",
};
// Primitive names follow the usual pattern: colour family plus a step (50, 100, 200 ... 900, 950). A higher step is a
// darker colour. Steps are assigned in order from light to dark, so they say "lighter than" and "darker than", not an
// exact lightness. Pure white is simply "white". These names exist only in Storybook: global.css still points the
// semantic tokens at the raw values.
const steps = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
const slug: Record<string, string> = { Neutral: "neutral", Cobalt: "cobalt" };
const cobaltSteps = [300, 600];
const ramps = order
  .map((name) => ({
    name,
    blurb: blurb[name],
    values: (() => {
      const hexes = [...used.keys()].filter((h) => family(h) === name).sort((x, y) => lum(y) - lum(x));
      let i = 0;
      return hexes.map((hex) => ({
        hex,
        name: hex === "#ffffff" ? "white" : `${slug[name]}-${(name === "Cobalt" ? cobaltSteps : steps)[i++]}`,
      }));
    })(),
  }))
  .filter((r) => r.values.length > 0);
const id = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

---

{view === "tokens" ? <TokenTable area="Colour" /> : view === "semantic" ? (
  <div class="ds-page">
    <h1>Semantic colour</h1>
    <p>Semantic tokens name a role, not a value. Components use these and only these for colour. Flip the theme in the toolbar: every name stays the same while its value changes. That stability is what lets a token survive a re-skin.</p>
    <nav aria-label="On this page">
      <ul class="ds-chips">
        {[{ t: "How to read it", n: undefined as number | undefined }, ...groups.map((g) => ({ t: g.title, n: g.rows.length })), { t: "State", n: states.length }].map((c) => <li><a href={`#${id(c.t)}`}>{c.t}{c.n !== undefined && <> <strong>{c.n}</strong></>}</a></li>)}
      </ul>
    </nav>

    <section>
      <h2 id="how-to-read-it">How to read it</h2>
      <ul>
        <li><strong>Token</strong>: the CSS variable. Use it as <code>color: var(--color-text-default)</code>. Never type the hex.</li>
        <li><strong>Light and Dark</strong>: the HEX value the token resolves to in each theme. The name never changes; the value does.</li>
        <li><strong>Contrast</strong>: under the hex of a text token, its WCAG ratio on <code>--color-background-default</code> in that theme, in a badge with the level it reaches ("18.7 AAA"). AAA (7 or more) is the strongest, AA (4.5 or more) is the minimum for body text, and AA large (3 or more) is for large text only.</li>
        <li><strong>Use</strong>: the job of the token. Pick by job, not by how the colour looks.</li>
      </ul>
    </section>
    {groups.map((g) => (
      <section>
        <h2 id={id(g.title)}>{g.title}</h2>
        <p>{groupBlurb[g.title]}</p>
        <table class="tok">
          <thead>
            <tr><th>Token</th><th>Light</th><th>Dark</th><th>Use</th></tr>
          </thead>
          <tbody>
            {g.rows.map((r) => (
              <tr>
                <td><code>--{r.n}</code></td>
                {[[r.l, r.lr], [r.d, r.dr]].map(([hex, cr]) => (
                  <td>
                    <div class="val">
                      <span class="val__hex"><span class="sw" style={`background:${hex}`}></span><code>{hex}</code></span>
                      {cr ? <span class={`badge badge--${levelClass(grade(cr as number))}`} title="Contrast on the page background"><span class="badge__n">{(cr as number).toFixed(1)}</span> {grade(cr as number)}</span> : null}
                    </div>
                  </td>
                ))}
                <td>{r.role}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
    <section>
      <h2 id="state">State</h2>
      <p>Interactive states are not colours of their own. The button's states are component tokens that point back at the roles above, so a theme change carries them along. Only <code>--color-accent</code> marks an interactive state or a result.</p>
      <table class="tok tok--state">
        <thead><tr><th>Token</th><th>Resting value</th></tr></thead>
        <tbody>
          {states.map((t) => (<tr><td><code>--{t.name}</code></td><td><code>{t.value}</code></td></tr>))}
        </tbody>
      </table>
    </section>
    <h2 id="read-next">Read next</h2>
    <ul>
      <li><a href="?path=/story/foundations-colour--primitives">Primitive colour</a>: the raw colours behind these roles.</li>
      <li><a href="?path=/story/foundations-typography--scales">Typography</a>: one family, one step per job.</li>
    </ul>
  </div>
) : (
  <div class="ds-page">
    <h1>Primitive colour</h1>
    <p>The raw colours behind the semantic tokens, in the light and dark themes. Each is named by colour family and a step: <code>neutral-50</code> is the lightest grey, <code>neutral-950</code> the darkest, and a higher step is always a darker colour. Pure white is just <code>white</code>. Primitives say what a colour is, never what it is for.</p>
    <nav aria-label="On this page">
      <ul class="ds-chips">
        {ramps.map((r) => <li><a href={`#${id(r.name)}`}>{r.name} <strong>{r.values.length}</strong></a></li>)}
      </ul>
    </nav>
    {ramps.map((r) => (
      <section>
        <h2 id={id(r.name)}>{r.name} <span class="count">{r.values.length}</span></h2>
        <p>{r.blurb} Lightest to darkest.</p>
        <div class="ramp">
          {r.values.map((v) => (
            <div class="step">
              <span class="chip" style={`background:${v.hex}`} role="img" aria-label={v.name}></span>
              <code class="hex">{v.name}</code>
            </div>
          ))}
        </div>
      </section>
    ))}
    <h2 id="read-next">Read next</h2>
    <ul>
      <li><a href="?path=/story/foundations-colour--semantic">Semantic colour</a>: the roles these colours fill, with their contrast.</li>
      <li><a href="?path=/story/foundations-colour--tokens">Colour tokens</a>: every colour token in one list, with its tier and light and dark values.</li>
    </ul>
  </div>
)}

<style>
  .val { display: grid; justify-items: start; gap: 8px; }
  .val__hex { display: inline-flex; align-items: center; }
  /* Pass levels as coloured chips: green for AAA and AA, amber for large text only, red for a fail. Fixed light chips with dark text, so they read the same on the light and the dark theme. */
  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: var(--font-size-micro); font-weight: 600; line-height: 1.6; letter-spacing: 0.02em; white-space: nowrap; }
  .badge__n { font-family: var(--font-family-mono); font-variant-numeric: tabular-nums; }
  .badge--aaa { background: #b6ebc6; color: #0a4a20; }
  .badge--aa { background: #d9f2e0; color: #145a2c; }
  .badge--large { background: #fde7b8; color: #6a4200; }
  .badge--low { background: #f9cdcc; color: #7a1312; }
  /* Fixed columns, so the Surfaces, Text, Lines and Accent tables line up with each other. */
  .tok th:nth-child(1) { width: 27%; }
  .tok th:nth-child(2), .tok th:nth-child(3) { width: 20%; }
  .tok th:nth-child(4) { width: 33%; }
  .tok--state th:nth-child(1) { width: 27%; }
  .tok--state th:nth-child(2) { width: 73%; }
  .tok code, .hex { font-family: var(--font-family-mono); font-size: 0.9em; }
  .hex { white-space: nowrap; color: var(--color-text-default); }
  /* The ring is a hairline that shows on a white swatch and on a near-black one, not the strong (ink) border. */
  .sw { display: inline-block; width: 28px; height: 28px; border-radius: 6px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-text-default) 22%, transparent); vertical-align: middle; margin-right: 10px; }
  .count { color: var(--color-text-muted); font-weight: 400; font-size: var(--font-size-small); margin-left: 6px; }
  .ramp { display: grid; grid-template-columns: repeat(auto-fill, minmax(108px, 1fr)); gap: 8px; margin-top: 16px; }
  .step { display: grid; gap: 8px; }
  .chip { display: block; height: 64px; border-radius: 8px; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-text-default) 22%, transparent); }
</style>
