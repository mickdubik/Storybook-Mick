---
import Button from "../Button.astro";
import Logo from "../Logo.astro";
import Navigation from "../Navigation.astro";
import { mailto, navItems } from "../../data/site";

interface Props {
  /** The header sits transparent at the top of the page and turns into the blurred bar once the page scrolls. */
  heroHeader?: boolean;
  /** On the home page the nav links are in-page anchors; elsewhere they point to /#section. */
  home?: boolean;
}
const { heroHeader = true, home = false } = Astro.props;
---

<header class:list={["masthead", heroHeader && "masthead--hero"]}>
  <div class:list={["wrap", "masthead__inner"]}>
    <Logo />
    <Navigation links={navItems(home)} />
    <div class="masthead__actions">
      <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 2.75 A7.25 7.25 0 0 1 10 17.25 Z" fill="currentColor" />
        </svg>
      </button>
      <Button href={mailto()} size="sm" short="Contact" class="btn--inv">Discuss project</Button>
    </div>
  </div>
</header>

<style>
/* Sticky header: solid by default, so content never shows through. Where the browser supports
         backdrop blur, it turns slightly translucent with a strong blur (progressive enhancement). One filter
         function only: the CSS minifier was joining "saturate(1.2) blur(12px)" into an invalid value. Users who
         ask for reduced transparency always get the solid header. */
      /* Sticky, and moved by ScrollChrome: it leaves with the page and returns quickly on an upward scroll. */
      .masthead {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--color-background-default);
        border-bottom: 1px solid var(--color-border-default);
      }

@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .masthead {
          background: color-mix(in srgb, var(--color-background-default) 82%, transparent);
          -webkit-backdrop-filter: blur(20px);
          backdrop-filter: blur(20px);
        }
}

@media (prefers-reduced-transparency: reduce) {
        .masthead { background: var(--color-background-default); -webkit-backdrop-filter: none; backdrop-filter: none; }
}

      .masthead__inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
        min-height: 68px;
      }



      .masthead__actions { display: flex; align-items: center; gap: 10px; justify-self: end; }

      .masthead__inner > :global(.brand) { justify-self: start; }

      /* Home: the header sits transparent over the hero (which slides up under it) until the page scrolls, and its
         content stands on the hero's own margins, so the logo lines up with the name and the button with the right edge. */
      .masthead--hero { transition: background-color 300ms ease, border-color 300ms ease, backdrop-filter 300ms ease, -webkit-backdrop-filter 300ms ease; }

      .masthead--hero:not(.is-scrolled) { background: transparent; border-bottom-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }


      /* Icon-only button: just the icon at rest (no outline); the button's own shape appears on hover as a
         low-contrast fill (8% ink), at the same 12px radius as the small buttons. 44px target. */
      .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--color-text-default);
        cursor: pointer;
        transition: background-color 200ms ease, transform 160ms var(--easing-out);
      }

      .theme-toggle:hover { background: color-mix(in srgb, var(--color-text-default) 8%, transparent); }

      .theme-toggle:active { transform: scale(0.97); }

@media (prefers-reduced-motion: reduce) { .theme-toggle:active { transform: none; }
}

      /* Below 760px the nav (in Navigation.astro) can't fit beside the lockup and the button without wrapping or crowding the name;
         it hides and the same links sit in the footer. The header's own grid then gives the room to the button. */
@media (max-width: 760px) {
        .masthead__inner { grid-template-columns: auto 1fr auto; }

        .masthead__actions { grid-column: 3; }
}
</style>
