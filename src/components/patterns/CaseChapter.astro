---
import Tags from "../Tags.astro";
import Shot from "../Shot.astro";
import Plate from "../Plate.astro";
import ButtonStates from "../ButtonStates.astro";
import ResultsTable from "../ResultsTable.astro";
import ComparisonTable from "../ComparisonTable.astro";
import SmartTrafficDemo from "../demos/SmartTrafficDemo.astro";
import DocPortalDemo from "../demos/DocPortalDemo.astro";
import DoctorOnlineDemo from "../demos/DoctorOnlineDemo.astro";
import type { CaseStudy } from "../../data/work";

interface Props {
  study: CaseStudy;
  /** The chapter to show, from `study.chapters`. */
  chapter: CaseStudy["chapters"][number];
  /** Position of the chapter in the case (0 for chapter 01). */
  n: number;
  showMeasured?: boolean;
}
const { study: c, chapter: ch, n, showMeasured: SHOW_MEASURED = false } = Astro.props;
const nn = (k: number) => String(k + 1).padStart(2, "0");
---

<section id={ch.id} class="chapter" aria-labelledby={`${ch.id}-h`} data-chapter>
  <h2 id={`${ch.id}-h`} class="chapter__h"><span class="mono" aria-hidden="true">{nn(n)}</span>{ch.title}</h2>
  {ch.blocks.map((b) => (
    <div class={`block block--${b.t}`}>
      {b.t === "statement" && <p class="chapter__statement">{b.text}</p>}

      {b.t === "prose" && <div class="prose">{b.paras.map((p) => <p>{p}</p>)}</div>}

      {b.t === "list" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <ul class="checklist">{b.items.map((it) => <li>{it}</li>)}</ul>
        </>
      )}

      {b.t === "lists" && (
        <div class="lists">
          {b.groups.map((g) => (
            <div>
              <p class="block__label mono">{g.label}</p>
              {g.intro && <p class="lists__intro">{g.intro}</p>}
              <ul class="checklist">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
      )}

      {b.t === "stats" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <div class={b.lead ? "statsplit" : undefined}>
          {b.lead && <div class="statsplit__lead">{b.lead.map((t) => <p>{t}</p>)}</div>}
          <dl class={`stats${b.viz ? " stats--viz" : ""}${b.lead || b.stack ? " stats--grid" : ""}${b.stack ? " stats--stack" : ""}`}>
            {b.items.map((s) => {
              const pct = /^(\d+)%$/.exec(s.value);
              const frac = /^(\d+) of (\d+)$/.exec(s.value);
              return (
                <div>
                  <dt class="figure-num stats__v">{s.value}</dt>
                  <dd>
                    <span class="stats__t">{s.label}</span>
                    {b.viz && pct && <span class="stats__bar" aria-hidden="true" style={`--p:${Number(pct[1]) / 100}`}></span>}
                    {b.viz && frac && <span class="stats__dots" aria-hidden="true">{Array.from({ length: Number(frac[2]) }, (_, k) => <i class={k < Number(frac[1]) ? "on" : ""}></i>)}</span>}
                  </dd>
                </div>
              );
            })}
          </dl>
          </div>
        </>
      )}

      {b.t === "personas" && (
        <div class="jobs">
          {b.items.map((p) => (
            <div class="job">
              <div class="job__who">
                <h3 class="job__name">{p.name}</h3>
                <p class="job__desc">{p.desc}</p>
              </div>
              <span class="job__rule" aria-hidden="true"></span>
              <div class="job__job">
                <p class="job__k mono">Job to be done</p>
                <p class="job__jtbd">{p.jtbd}</p>
              </div>
            </div>
          ))}
        </div>
      )}

      {b.t === "cards" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <dl class={`cards${b.numbered ? " cards--row" : ""}`}>
            {b.items.map((p) => (
              <div>
                <dt>{p.title}</dt>
                <dd>{p.body}</dd>
              </div>
            ))}
          </dl>
        </>
      )}

      {b.t === "quotes" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <ul class={`quotes${b.items.length === 3 ? " quotes--row" : ""}`}>{b.items.map((q) => <li><q>{q}</q></li>)}</ul>
        </>
      )}

      {b.t === "tags" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <Tags items={b.items} />
        </>
      )}

      {b.t === "hypotheses" && (
        <ol class="bets">
          {b.items.map((h, k) => (
            <li class="bet">
              <p class="bet__area mono">
                H{k + 1} · {h.area}
                {h.verdict && <span class={`bet__verdict bet__verdict--${h.verdict.status.toLowerCase()}`}>{h.verdict.status}</span>}
              </p>
              <p class="bet__context">{h.context}</p>
              <p class="bet__belief">{h.belief}</p>
              {h.img && <Shot img={h.img} />}
              <p class="block__label mono">Trade-offs</p>
              <ul class="checklist">{h.tradeoffs.map((t) => <li>{t}</li>)}</ul>
              {h.verdict?.reason && (
                <>
                  <p class="block__label mono bet__why">Evidence</p>
                  <ul class="checklist bet__reason"><li>{h.verdict.reason}</li></ul>
                </>
              )}
            </li>
          ))}
        </ol>
      )}

      {b.t === "beforeAfter" && <ComparisonTable caption="Design system metrics before and after" rows={b.rows} />}
      {b.t === "beforeAfter" && SHOW_MEASURED && c.measured && <p class="measured mono"><span>How measured</span> {c.measured}</p>}

      {b.t === "results" && b.lead && (
        <ul class="lead">
          {b.items.slice(0, b.lead).map((m) => (
            <li>
              <span class="figure-num lead__num">{m.value}{m.unit}</span>
              <span class="lead__label">{m.label}</span>
            </li>
          ))}
        </ul>
      )}
      {b.t === "results" && <ResultsTable caption={`Reported results for ${c.product}`} items={b.items.slice(b.lead ?? 0)} />}
      {b.t === "results" && SHOW_MEASURED && c.measured && <p class="measured mono"><span>How measured</span> {c.measured}</p>}

      {b.t === "image" && <Shot img={b.img} />}

      {b.t === "gallery" && b.compare && b.imgs.length === 2 && (
        <div class="cmp" data-cmp>
          <div class="cmp__stack" hidden>
            <div class="cmp__a"><Shot img={{ ...b.imgs[0], caption: undefined }} sizes="(min-width: 1200px) 1000px, 92vw" /></div>
            <div class="cmp__b"><Shot img={{ ...b.imgs[1], caption: undefined }} sizes="(min-width: 1200px) 1000px, 92vw" /></div>
            <span class="cmp__tag cmp__tag--a mono" aria-hidden="true">{b.imgs[0].caption}</span>
            <span class="cmp__tag cmp__tag--b mono" aria-hidden="true">{b.imgs[1].caption}</span>
            <span class="cmp__handle" aria-hidden="true"></span>
            <input class="cmp__range" type="range" min="0" max="100" value="50" aria-label={`Compare ${b.imgs[0].caption?.toLowerCase()} and ${b.imgs[1].caption?.toLowerCase()}: move to reveal`} />
          </div>
          <div class="gallery cmp__fallback">{b.imgs.map((img) => <Shot img={img} />)}</div>
        </div>
      )}
      {b.t === "gallery" && !b.compare && (
        <div class:list={["gallery", b.wide && "gallery--wide"]}>{b.imgs.map((img) => <Shot img={img} fitAr={Math.min(...b.imgs.map((i) => i.w / i.h).filter((r) => r >= 1.4))} />)}</div>
      )}

      {b.t === "demo" && (
        <div class="block__demo" style="--cover-ar: 1.6">
          {b.demo === "smartTraffic" ? <SmartTrafficDemo caption={b.caption} /> : b.demo === "docPortal" ? <DocPortalDemo /> : <DoctorOnlineDemo />}
        </div>
      )}

      {b.t === "plate" && <Plate variant={b.variant} title={b.title} caption={b.caption} note={b.note} />}

      {b.t === "tokenChain" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <ol class="chain">
            {b.steps.map((st) => (
              <li class="chain__step">
                <span class="chain__kind mono">{st.kind}</span>
                <code class="chain__name">
                  {st.swatch && <i class="chain__sw" style={`background:${st.swatch}`} aria-hidden="true"></i>}
                  <span>{st.name.split("/").map((part, k) => (k ? <><wbr />/{part}</> : part))}</span>
                </code>
                <span class="chain__hint">{st.hint}</span>
              </li>
            ))}
          </ol>
          <p class="chain__note">{b.note}</p>
        </>
      )}

      {b.t === "decision" && (
        <>
          {b.label && <p class="block__label mono">{b.label}</p>}
          <p class="decision__lead">{b.lead}</p>
          <div class="decision">
            {b.options.map((o) => (
              <div class={`decision__opt${o.chosen ? " is-chosen" : ""}`}>
                <p class="decision__tag mono">{o.tag}</p>
                <h3 class="decision__title">{o.title}</h3>
                {o.body && <p class="decision__body">{o.body}</p>}
                {o.points && <ul class="decision__points">{o.points.map((pt) => <li>{pt}</li>)}</ul>}
              </div>
            ))}
          </div>
        </>
      )}

      {b.t === "buttonStates" && <ButtonStates title={b.title} caption={b.caption} note={b.note} />}
    </div>
  ))}
</section>

<style>
/* ---------- Visual moments inside chapters ---------- */
  .lists__intro { color: var(--color-text-secondary); font-size: var(--font-size-small); margin: -4px 0 12px; max-width: var(--size-measure); }

  /* Stats with a picture of the figure: every figure has the same structure. Number on top, its meter (a bar per %, dots per "X of Y") 14px under it
     and as wide as the number, caption beside both. The dd's children join the row grid (display: contents); contain: inline-size keeps the meter from
     widening the number column, and min-width gives every number the same column so captions start at one edge. Decorative; the number stays as text. */
  .stats.stats--viz div { grid-template-rows: auto 1fr; row-gap: 14px; }

  .stats--viz dd { display: contents; }

  .stats--viz .stats__v { min-width: 2.45em; white-space: nowrap; }

  .stats--viz .stats__t { grid-column: 2; grid-row: 1 / span 2; }

  .stats--viz .stats__dots, .stats--viz .stats__bar { grid-column: 1; grid-row: 2; align-self: start; contain: inline-size; min-width: 0; }

  .stats--viz .stats__dots { justify-content: space-between; }

  .stats__bar { display: block; height: 8px; background: var(--color-background-muted); border-radius: 4px; overflow: hidden; }

  .stats__bar::after { content: ""; display: block; height: 100%; background: var(--color-accent); transform-origin: 0 50%; transform: scaleX(var(--p)); }

  .stats__dots { display: flex; gap: 6px; }

  .stats__dots i { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--color-text-muted); }

  .stats__dots i.on { background: var(--color-accent); border-color: var(--color-accent); }

  /* Principles as a numbered row */
  .cards.cards--row { grid-template-columns: minmax(0, 1fr); }

@media (min-width: 640px) { .cards.cards--row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (min-width: 1100px) { .cards.cards--row { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px 24px; }
}

  .cards--row dt { font-family: var(--font-family-sans); font-size: var(--font-size-body); line-height: 1.2; }

@media (min-width: 1100px) { .cards--row dd { font-size: var(--font-size-small); }
}

  /* Three questions side by side */
@media (min-width: 1100px) {
    .quotes.quotes--row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; max-width: none; }

    .quotes.quotes--row li { border-bottom: 0; border-top: 2px solid var(--color-text-default); padding-top: 16px; }
}

  /* Results: the three headline figures lead, the rest follow as a table */
  .lead { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 1px solid var(--color-border-strong); margin-bottom: 24px; max-width: 760px; }

@media (min-width: 760px) { .lead { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: none; border-top: 0; gap: 24px; margin-bottom: 32px; }
}

  .lead li { display: grid; gap: 8px; align-content: start; padding-block: 16px; border-bottom: 1px solid var(--color-border-default); }

@media (min-width: 760px) { .lead li { border-bottom: 0; border-top: 2px solid var(--color-text-default); padding-top: 16px; }
}

  .lead__num { font-size: clamp(2.8rem, 2rem + 3vw, 4.4rem); color: var(--color-accent); line-height: 1; }

  .lead__label { color: var(--color-text-secondary); max-width: 28ch; }

  /* Before / after slider: moved by the visitor (no autoplay). Without script the two images stay side by side. */
  .cmp__stack { position: relative; }

  .cmp__stack[hidden] { display: none; }

  .cmp.is-ready .cmp__stack { display: block; }

  .cmp.is-ready .cmp__fallback { display: none; }

  .cmp__b { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos, 50%)); }

  .cmp__tag { position: absolute; top: 16px; padding: 4px 10px; border-radius: 999px; background: var(--color-background-default); color: var(--color-text-default); font-size: var(--font-size-micro); box-shadow: 0 0 0 1px var(--color-border-default); }

  .cmp__tag--a { left: 16px; }

  .cmp__tag--b { right: 16px; }

  .cmp__handle { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; margin-left: -1px; background: var(--color-background-default); box-shadow: 0 0 0 1px var(--color-text-muted); pointer-events: none; }

  .cmp__handle::after { content: ""; position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%; background: var(--color-background-default); box-shadow: 0 0 0 1px var(--color-text-muted), 0 2px 8px rgba(0,0,0,.18); }

  .cmp__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }

  .cmp__stack:has(.cmp__range:focus-visible) .cmp__handle::after { box-shadow: 0 0 0 3px var(--color-accent); }

  .block__demo { max-width: calc(80svh * var(--cover-ar, 1.6)); }

  .chapter {
    min-width: 0;
    padding-block: clamp(56px, 7vw, 112px); /* room to breathe between chapters (2026-10-24; was 32-56px). 240px was tried 2026-11-06 and reverted by the owner. */
    scroll-margin-top: 88px; /* no rule between chapters (2026-11-06): the space separates them */
  }

  .chapter:first-child { padding-top: 0; }

  .chapter:last-child { padding-bottom: 0; }
 /* the page body already pads below the last chapter */
  .chapter__h {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: var(--space-group);
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: var(--font-size-h3);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .chapter__h .mono { color: var(--color-text-muted); }

  .block + .block { margin-top: var(--space-block); }

  .block__label { color: var(--color-text-muted); margin-bottom: 12px; }

  /* A lead statement under a chapter title: lighter and smaller than the title so the two do not fight. */
  .chapter__statement {
    font-family: var(--font-family-sans);
    font-size: var(--font-size-lede);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    max-width: var(--size-measure); /* 10 to 11 words per line, whatever the size */
    text-wrap: pretty;
  }


  /* A list that ends a chapter does not close with its own rule: the next chapter's rule does it, a few pixels lower. */
  .chapter > .block:last-child :is(.quotes, .checklist) > li:last-child { border-bottom: 0; }

  /* Two columns of figures: the last item of each column has no closing line, not only the very last item (owner, 2026-11-09). */
@media (min-width: 640px) { .stats > div:nth-last-child(-n+2) { border-bottom: 0; }
}

  .checklist { max-width: var(--size-measure-prose); border-top: 1px solid var(--color-border-default); }

  .checklist li {
    position: relative;
    padding: 11px 0 11px 26px;
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-secondary);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .checklist li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.35em;
    width: 12px;
    height: 1px;
    background: var(--color-text-muted);
  }

  .lists { display: grid; gap: 32px var(--space-column-gap); grid-template-columns: minmax(0, 1fr); }

@media (min-width: 760px) { .lists { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}


  .stats { display: grid; grid-template-columns: minmax(0, 1fr); border-top: 1px solid var(--color-border-strong); }

@media (min-width: 640px) { .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-column-gap); }
}

  .stats div { display: grid; grid-template-columns: minmax(4.6rem, auto) 1fr; gap: 16px; align-items: baseline; padding-block: 16px; border-bottom: 1px solid var(--color-border-default); }

  /* Text left, figures stacked right: big number over a small caption, no rules (owner, 2026-11-09). */
  .statsplit { display: grid; gap: var(--space-block) clamp(40px, 6vw, 88px); grid-template-columns: minmax(0, 1fr); align-items: start; }

  /* Side by side only where the text column is wide enough for both halves (the case contents sidebar takes about 300px); below that the figures sit under the text. */
@media (min-width: 1280px) { .statsplit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

  .statsplit__lead p + p { margin-top: 1em; }

  .statsplit__lead { color: var(--color-text-secondary); font-size: 1.125rem; line-height: 1.6; text-wrap: pretty; max-width: var(--size-measure-prose); }

  /* A lone figure is a callout card (same recipe as the chain and decision cards): number left, caption beside it. */
  .stats:not(.stats--grid):has(> div:only-child) { grid-template-columns: minmax(0, 1fr); border-top: 0; }

  .stats:not(.stats--grid) > div:only-child { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 24px; align-items: center; padding: 24px; border: 1px solid var(--color-border-default); border-radius: 12px; background: var(--color-background-subtle); }

  .stats:not(.stats--grid) > div:only-child .stats__v { font-size: clamp(2.2rem, 1.6rem + 2vw, 3.25rem); line-height: 1; }

  .stats:not(.stats--grid) > div:only-child dd { max-width: 44ch; text-wrap: pretty; }

  .stats--grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px clamp(28px, 3.5vw, 48px); border-top: 0; }

  /* Stacked figures without a text column beside them (Doctor Online): three across where the text column is wide enough. */
@media (min-width: 1100px) { .stats--stack { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

  /* ...as tiles: the same card recipe as the lone-figure callout (1px rule, 12px radius, paper-2). */
  .stats.stats--grid.stats--stack { gap: var(--space-tile); }
 /* the same gap as the persona cards */
  .stats.stats--grid.stats--stack > div { padding: 24px; border: 1px solid var(--color-border-default); border-radius: 12px; background: var(--color-background-subtle); }

  /* Bento: the headline figure is the big tile (the full width on two columns, two of three wide from 1100px), the rest are single tiles. */
  .stats.stats--grid.stats--stack > div:first-child { grid-column: 1 / -1; }

@media (min-width: 1100px) { .stats.stats--grid.stats--stack > div:first-child { grid-column: span 2; }
}

  .stats.stats--grid.stats--stack > div:first-child .stats__v { font-size: clamp(3.2rem, 2rem + 3vw, 4.75rem); }

  .stats--grid div { display: block; padding-block: 0; border-bottom: 0; }

  .stats--grid .stats__v { font-size: clamp(2.2rem, 1.5rem + 1.6vw, 3rem); line-height: 1.05; }

  .stats--grid dd { margin-top: 6px; font-size: 0.9375rem; }

  .stats__v { font-size: clamp(1.9rem, 1.5rem + 1.2vw, 2.6rem); }

  .stats dd { color: var(--color-text-secondary); }

  /* Plain figure rows (not the viz bars, not the lead grid, not a lone callout): every row in a list shares one number column, as wide as the widest figure
     in that list, with a 24px gap before the caption. So the captions line up AND no row has a bigger gap than another (owner, 2026-11-09). */
  .stats:not(.stats--viz):not(.stats--grid):not(:has(> div:only-child)) { grid-template-columns: auto minmax(0, 1fr); }

  .stats:not(.stats--viz):not(.stats--grid):not(:has(> div:only-child)) > div { grid-column: 1 / -1; grid-template-columns: subgrid; column-gap: 24px; }

@media (min-width: 640px) {
    .stats:not(.stats--viz):not(.stats--grid):not(:has(> div:only-child)) { grid-template-columns: auto minmax(0, 1fr) var(--space-column-gap) auto minmax(0, 1fr); column-gap: 0; }

    .stats:not(.stats--viz):not(.stats--grid):not(:has(> div:only-child)) > div:nth-child(odd) { grid-column: 1 / 3; }

    .stats:not(.stats--viz):not(.stats--grid):not(:has(> div:only-child)) > div:nth-child(even) { grid-column: 4 / 6; }
}


  /* Token chain: three steps from component to core value, each one resolving to the next (live text). */
  .chain { display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); counter-reset: none; }

@media (min-width: 760px) { .chain { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
}

  .chain__step { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 20px 22px; border: 1px solid var(--color-border-default); background: var(--color-background-subtle); border-radius: 12px; }

  .chain__step:first-child { border-color: var(--color-border-strong); }
 /* the core value, where the chain starts */
  .chain__step + .chain__step::before { content: "→"; position: absolute; color: var(--color-text-muted); left: 50%; top: -24px; transform: translateX(-50%) rotate(90deg); font-size: 1.1rem; line-height: 1; }

@media (min-width: 760px) { .chain__step + .chain__step::before { left: -30px; top: 50%; transform: translateY(-50%); }
}

  .chain__kind { color: var(--color-text-muted); }

  .chain__name { display: flex; align-items: center; gap: 10px; font-family: var(--font-family-mono, ui-monospace, monospace); font-size: 0.875rem; color: var(--color-text-default); overflow-wrap: normal; }

  .chain__sw { flex: none; width: 20px; height: 20px; border-radius: 5px; }

  .chain__hint { color: var(--color-text-secondary); font-size: 0.9375rem; }

  .chain__note { margin-top: 20px; padding-inline: 12px; /* = the cards' corner radius (the notes rule) */ color: var(--color-text-secondary); line-height: 1.6; text-wrap: pretty; }


