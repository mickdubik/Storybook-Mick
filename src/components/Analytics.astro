---
// Visitor analytics: Google Analytics 4, Amplitude and Mixpanel, behind one consent banner. Nothing loads or sends
// until the visitor accepts. A small card at the bottom right asks once: Decline / Accept. Accept starts all three
// tools and Amplitude Session Replay; Decline starts none. The choice is stored in localStorage "md-consent"
// as "granted" or "denied". (Reverted 2026-11-15 to the published version; the slim bar with a settings dialog
// is kept in docs/prototypes/consent-settings-dialog/.)
// A handful of custom events make up the funnel:  land -> scroll (25 / 50 / 90%) -> open a case -> contact action.
// No markup changes are needed: clicks are picked up by one delegated listener, keyed on the link itself.
//   case_open       { case }                      a click on a link to /work/<slug>
//   contact_email   { from }                      a mailto: link
//   contact_copy    { from }                      the footer "Copy email" button
//   contact_linkedin{ from }                      a link to linkedin.com
//   resume_open     { from }                      a link to the resume (Google Drive)
//   book_call       { from }                      a link to the Cal.com booking page
//   scroll_depth    { depth, page }               25, 50 and 90% of the page, once each per page view
// GA4 (G-XSW698HT2B) keeps first-touch UTM attribution per visitor; Mixpanel and Amplitude get the same events.
// Amplitude only gets case_open from the code below, plus its own autocapture and (if allowed) Session Replay.
---

<script>
  import { initAll, track as amplitudeTrack } from "@amplitude/unified";
  import mixpanel from "mixpanel-browser";

  const GA_ID = "G-XSW698HT2B";
  // Token and optional API host (EU residency: https://api-eu.mixpanel.com) come from PUBLIC_MIXPANEL_*.
  // The Amplitude project key (EU project) is public and ingestion-only: PUBLIC_AMPLITUDE_API_KEY.
  const mpToken = import.meta.env.PUBLIC_MIXPANEL_TOKEN;
  const amplitudeKey = import.meta.env.PUBLIC_AMPLITUDE_API_KEY;

  const KEY = "md-consent";
  const readChoice = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const writeChoice = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private mode */ } };

  let gaReady = false, mpReady = false, ampReady = false;

  // Each start function runs only after consent, and at most once. Nothing is loaded or sent before that.
  const startGA = () => {
    if (gaReady || !import.meta.env.PROD) return;
    gaReady = true;
    const s = document.createElement("script");
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(s);
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () { w.dataLayer.push(arguments); };
    w.gtag("js", new Date());
    w.gtag("config", GA_ID);
  };
  const startMixpanel = () => {
    if (mpReady || !mpToken) return;
    try {
      mixpanel.init(mpToken, {
        api_host: import.meta.env.PUBLIC_MIXPANEL_API_HOST || "https://api-js.mixpanel.com",
        track_pageview: "full-url",
        persistence: "localStorage",
        debug: !import.meta.env.PROD,
      });
      mpReady = true;
    } catch { /* analytics must never break the page */ }
  };
  const startAmplitude = () => {
    if (ampReady || !amplitudeKey) return;
    try {
      initAll(amplitudeKey, {
        serverZone: "EU",
        analytics: { autocapture: true },
        sessionReplay: { sampleRate: 1 },
      });
      ampReady = true;
    } catch { /* analytics must never break the page */ }
  };
  const startAll = () => { startGA(); startMixpanel(); startAmplitude(); };

  // Accept is the design-system secondary button, without its arrow or ring (owner, 2026-11-15).
  const showBar = () => {
    const bar = document.createElement("div");
    bar.className = "consent";
    bar.setAttribute("role", "region");
    bar.setAttribute("aria-labelledby", "consent-title");
    bar.innerHTML =
      '<div class="consent__copy"><p class="consent__title" id="consent-title">Improve your experience</p>' +
      '<p>I use analytics and session recordings to see what helps. Nothing sold.</p></div>' +
      '<div class="consent__actions"><button type="button" class="btn btn--sm btn--ghost" data-icon="none" data-consent="denied">' +
      '<span class="btn__roll"><span class="btn__text">Decline</span><span class="btn__text btn__text--echo" aria-hidden="true">Decline</span></span></button>' +
      '<button type="button" class="btn btn--sm btn--secondary" data-icon="none" data-consent="granted">' +
      '<span class="btn__roll"><span class="btn__text">Accept</span><span class="btn__text btn__text--echo" aria-hidden="true">Accept</span></span></button></div>';
    bar.addEventListener("click", (e) => {
      const b = (e.target as Element).closest("[data-consent]") as HTMLElement | null;
      if (!b) return;
      const v = b.dataset.consent as string;
      writeChoice(v);
      if (v === "granted") startAll();
      bar.remove();
    });
    document.body.appendChild(bar);
  };

  const stored = readChoice();
  if (stored === "granted") startAll();
  // Nothing to ask about when no tool is configured (local dev without keys).
  // "?og" is used by scripts/make-og.sh so the social preview screenshots do not show the banner. Nothing loads either way.
  else if (!stored && !location.search.includes("og") && (import.meta.env.PROD || !!mpToken || !!amplitudeKey)) showBar();

  const send = (name: string, data?: Record<string, string>) => {
    if (gaReady) { try { (window as any).gtag("event", name, data || {}); } catch { /* analytics must never break the page */ } }
    if (mpReady) { try { mixpanel.track(name, data); } catch { /* same for Mixpanel */ } }
  };
  const here = () => location.pathname.replace(/\/$/, "") || "/";

  document.addEventListener("click", (e) => {
    const t = e.target as Element | null;
    if (!t || !t.closest) return;
    if (t.closest("[data-copy]")) return send("contact_copy", { from: here() });
    const a = t.closest("a[href]") as HTMLAnchorElement | null;
    if (!a) return;
    const href = a.getAttribute("href") || "";
    if (href.startsWith("mailto:")) return send("contact_email", { from: here() });
    let url: URL;
    try { url = new URL(href, location.href); } catch { return; }
    if (/(^|\.)linkedin\.com$/.test(url.hostname)) return send("contact_linkedin", { from: here() });
    if (url.hostname === "drive.google.com") return send("resume_open", { from: here() });
    if (url.hostname === "cal.com") return send("book_call", { from: here() });
    if (url.origin === location.origin) {
      const m = url.pathname.match(/^\/work\/([^/]+)\/?$/);
      if (m) {
        send("case_open", { case: m[1] });
        if (ampReady) { try { amplitudeTrack("case_open"); } catch { /* same for Amplitude */ } }
      }
    }
  });

  // Scroll depth, measured against the whole page, fired once per level.
  const levels = [25, 50, 90];
  const done = new Set<number>();
  let ticking = false;
  const check = () => {
    ticking = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - window.innerHeight;
    if (max <= 0) return;
    const pct = (window.scrollY / max) * 100;
    for (const l of levels) {
      if (pct >= l && !done.has(l)) {
        done.add(l);
        send("scroll_depth", { depth: String(l), page: here() });
      }
    }
  };
  window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(check); } }, { passive: true });
</script>

<style is:global>
  /* The consent card: bottom right. It hugs its content (text block 22rem, then the buttons), so the buttons sit next to the text. */
  .consent {
    position: fixed; z-index: 60;
    right: var(--gutter); bottom: var(--gutter);
    width: max-content; max-width: calc(100vw - 2 * var(--gutter));
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px;
    padding: 24px 20px 24px 28px; /* the text side gets more room than the button side */
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 28px; /* concentric with the 12px buttons: 12 + 20 padding = 32, eased to 28 */
    /* A little lift (owner, 2026-11-15, an exception to "no card shadows" in rules/visual.md): soft, wide, low contrast. */
    box-shadow: 0 1px 2px color-mix(in srgb, var(--ink) 6%, transparent), 0 10px 32px color-mix(in srgb, var(--ink) 12%, transparent);
    font: 400 var(--t-small)/1.4 var(--font-sans);
  }
  .consent__copy { flex: 0 1 18rem; display: grid; gap: 6px; }
  /* Same glass as the header: translucent paper with a strong blur; solid for reduced transparency. */
  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .consent { background: color-mix(in srgb, var(--paper) 82%, transparent); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .consent { background: var(--paper); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  /* Dark theme (owner, 2026-11-15): the shadow must be darker than the card. Ink is light here, so the light-theme
     shadow would glow. Use pure black, stronger, and lift the card surface one step (--paper-2) so it reads as raised. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .consent {
      background: color-mix(in srgb, var(--paper-2) 86%, transparent);
      box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 7%, transparent), 0 1px 2px rgb(0 0 0 / 0.5), 0 12px 36px rgb(0 0 0 / 0.6);
    }
  }
  :root[data-theme="dark"] .consent {
    background: color-mix(in srgb, var(--paper-2) 86%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 7%, transparent), 0 1px 2px rgb(0 0 0 / 0.5), 0 12px 36px rgb(0 0 0 / 0.6);
  }
  @media (prefers-reduced-transparency: reduce) {
    :root[data-theme="dark"] .consent { background: var(--paper-2); }
  }
  .consent p { margin: 0; }
  .consent .consent__title { font: 600 1rem/1.3 var(--font-sans); letter-spacing: -0.01em; }
  .consent__actions { display: flex; gap: 8px; }
  /* Phones: full width, text above, the two buttons share the row. */
  @media (max-width: 560px) {
    .consent { left: var(--gutter); width: auto; }
    .consent__copy { flex: 1 1 100%; }
    .consent__actions { width: 100%; }
    .consent__actions .btn { flex: 1; justify-content: center; }
  }
  /* <button> has a default border; the design-system .btn is an <a> with none. */
  .consent .btn { border: 0; font-family: var(--font-sans); }
  .consent .btn--secondary { box-shadow: none; }
  .consent button:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
</style>
