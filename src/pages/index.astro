<script>
  import { createTechText, canTechText } from "../scripts/tech-text";
  // TechText on the hero name (owner, 2026-11-10): "MICK" types in first, then "DUBIK" (1 s each, about 2 s in all).
  // Letters turn into dashed outlines under the pointer, with the selection frame, specks, size label and type guides;
  // a click kicks the letters (spring, bounce 0.5). No idle sweep: nothing moves unless the pointer does.
  {
    const title = document.querySelector<HTMLElement>(".hero__title.tt-on");
    if (title && canTechText()) {
      const cursors = new Map<number, string>();
      const lines = [...title.querySelectorAll<HTMLElement>(".hero__l1, .hero__l2")];
      lines.forEach((host, k) => {
        const box = document.createElement("div");
        box.className = "tt-box";
        box.setAttribute("aria-hidden", "true");
        host.append(box);
        createTechText({
          host, container: box, target: title,
          pad: { top: 40, left: 24 },
          onCursor: (c: string) => { cursors.set(k, c); title.style.cursor = [...cursors.values()].find(Boolean) ?? ""; },
          options: { introDuration: 1, introDelay: k * 1.0, background: () => getComputedStyle(title.closest(".hero")!).backgroundColor },
        });
      });
      title.dataset.ttReady = "1";
    } else title?.classList.remove("tt-on");
  }
  // Home behaviour. Small jobs, all cheap (the scroll parallax is CSS, see the hero styles):
  // 1. The current-role tag pings its dot twice when it comes into view (and again on hover, in CSS).
  // 2. The hero card's left edge follows the header tabs' left edge (measured, so it holds at any width and after fonts load).
  // 3. The ambient shapes only run while the hero is on screen.
  // 4. Pointer, inside the hero: the cursor glow follows the pointer, and the name (Mick Dubik, not the role line) drifts a few pixels against it.
  //    Both are eased over time (not per frame), so they are smooth at any frame rate. Desktop layout, fine pointer and
  //    no-reduced-motion only. The drift uses `transform` on the name (the h1); the scroll parallax uses `translate`, so
  //    the two never fight.
  // Lead case: the work-list card that takes up most of the screen (visible height) gets data-lead; CSS shows it at full strength while the pointer is away from the list.
  const caseLinks = [...document.querySelectorAll<HTMLElement>(".case__link")];
  if (caseLinks.length && matchMedia("(hover: hover)").matches) {
    let ticking = false;
    const pickLead = () => {
      ticking = false;
      let best: HTMLElement | null = null, bestH = 0;
      for (const el of caseLinks) {
        const r = el.getBoundingClientRect();
        const h = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
        if (h > bestH) { bestH = h; best = el; }
      }
      caseLinks.forEach((el) => { if (el === best && bestH > 0) el.setAttribute("data-lead", ""); else el.removeAttribute("data-lead"); });
    };
    const queue = () => { if (!ticking) { ticking = true; requestAnimationFrame(pickLead); } };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    pickLead();
  }

  const pulse = document.querySelectorAll<HTMLElement>("[data-pulse]");
  if (pulse.length && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      (e.target as HTMLElement).dataset.on = "";
      io.unobserve(e.target);
    }), { threshold: 0.8 });
    pulse.forEach((el) => io.observe(el));
  } else pulse.forEach((el) => (el.dataset.on = ""));

  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero) {
    const nav = document.querySelector<HTMLElement>(".masthead__nav");
    const dock = hero.querySelector<HTMLElement>(".hero__dock")!;
    const titleEl = hero.querySelector<HTMLElement>(".hero__title"); // only the name drifts with the pointer, not the role line
    const glow = hero.querySelector<HTMLElement>(".hero__glow");
    const wide = matchMedia("(min-width: 1200px)");
    const calm = matchMedia("(prefers-reduced-motion: no-preference)");
    const fine = matchMedia("(hover: hover) and (pointer: fine)");

    // offset of the nav's left edge from the dock's left edge (the dock is centred beyond 1920px, so this stays exact)
    const align = () => {
      if (nav && wide.matches) hero.style.setProperty("--card-x", `${nav.getBoundingClientRect().left - dock.getBoundingClientRect().left}px`);
      else hero.style.removeProperty("--card-x");
    };
    align();
    addEventListener("resize", align);
    document.fonts?.ready.then(align);

    let px = 0, py = 0, cx = 0, cy = 0, tx = 0, ty = 0, gx = 0, gy = 0, last = 0, raf = 0, onScreen = true, inside = false;
    // While the page scrolls the name is pinned to the background (CSS), so the pointer drift holds still: nothing is written to it mid-scroll.
    let scrolling = false, scrollTimer = 0;
    const on = () => calm.matches && wide.matches && fine.matches;
    const paint = (now: number) => {
      raf = 0;
      const dt = Math.min(64, now - (last || now));
      last = now;
      const kDrift = 1 - Math.exp(-dt / 160);
      const kGlow = 1 - Math.exp(-dt / 120);
      if (!scrolling) { cx += (px - cx) * kDrift; cy += (py - cy) * kDrift; }
      gx += (tx - gx) * kGlow; gy += (ty - gy) * kGlow;
      if (titleEl && !scrolling) titleEl.style.transform = `translate3d(${(-cx * 5).toFixed(2)}px, ${(-cy * 2.5).toFixed(2)}px, 0)`;
      if (glow) glow.style.transform = `translate3d(${gx.toFixed(1)}px, ${gy.toFixed(1)}px, 0)`;
      const settling = (!scrolling && (Math.abs(px - cx) > 0.0005 || Math.abs(py - cy) > 0.0005)) || Math.abs(tx - gx) > 0.2 || Math.abs(ty - gy) > 0.2;
      if (settling) raf = requestAnimationFrame(paint); else last = 0; // no frame loop while idle: the pointer wakes it
    
    };
    const kick = () => { if (!raf && onScreen) raf = requestAnimationFrame(paint); };
    addEventListener("scroll", () => { scrolling = true; clearTimeout(scrollTimer); scrollTimer = window.setTimeout(() => { scrolling = false; kick(); }, 140); }, { passive: true });
    const reset = () => { px = py = cx = cy = 0; if (titleEl) titleEl.style.transform = ""; hero.classList.remove("is-hover"); };

    new IntersectionObserver((es) => {
      onScreen = es[0].isIntersecting;
      hero.classList.toggle("is-off", !onScreen);
    }).observe(hero);
    hero.addEventListener("pointermove", (e) => {
      if (!on()) return;
      const r = hero.getBoundingClientRect();
      tx = e.clientX - r.left; ty = e.clientY - r.top;
      if (!inside) { inside = true; gx = tx; gy = ty; hero.classList.add("is-hover"); }
      if (!(e.target as HTMLElement).closest("a")) {
        px = Math.max(-1, Math.min(1, (e.clientX / innerWidth) * 2 - 1));
        py = Math.max(-1, Math.min(1, (e.clientY / innerHeight) * 2 - 1));
      }
      kick();
    });
    hero.addEventListener("pointerleave", () => { inside = false; px = py = 0; hero.classList.remove("is-hover"); kick(); });
    wide.addEventListener("change", () => { if (!on()) reset(); align(); });
    calm.addEventListener("change", () => { if (!on()) reset(); });
  }

  // Exploration: an animation plays once when it comes into view (inside its iframe) and replays on hover. One control
  // in the corner: pause while it plays, play while it is paused, replay once it has finished (owner, 2026-11-12).
  type XpFrame = Window & { replayNow?: () => void; pause?: () => void; resume?: () => void };
  const HINT: Record<string, string> = { playing: "Pause", paused: "Play", done: "Replay" };
  const VERB: Record<string, string> = { playing: "Pause", paused: "Play", done: "Replay" };
  const setXp = (btn: HTMLElement, state: string) => {
    btn.dataset.state = state;
    btn.setAttribute("aria-label", `${VERB[state]} ${btn.dataset.label ?? ""}`.trim());
    const hint = btn.querySelector(".replay__hint");
    if (hint) hint.textContent = HINT[state];
  };
  document.querySelectorAll<HTMLElement>(".xp__card").forEach((card) => {
    const frame = card.querySelector<HTMLIFrameElement>(".xp__embed");
    const btn = card.querySelector<HTMLElement>(".replay");
    btn?.addEventListener("click", () => {
      const w = frame?.contentWindow as XpFrame | null | undefined;
      try {
        const st = btn.dataset.state;
        if (st === "playing") w?.pause?.();
        else if (st === "paused") w?.resume?.();
        else w?.replayNow?.();
      } catch {}
    });
  });
  // The embedded animations report their state; the control follows it.
  window.addEventListener("message", (e) => {
    const d = e.data as { type?: string; state?: string } | null;
    if (!d || d.type !== "xp-state" || !d.state || !HINT[d.state]) return;
    document.querySelectorAll<HTMLElement>(".xp__card").forEach((card) => {
      const frame = card.querySelector<HTMLIFrameElement>(".xp__embed");
      const btn = card.querySelector<HTMLElement>(".replay");
      if (frame && btn && e.source === frame.contentWindow) setXp(btn, d.state!);
    });
  });
  if (matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>(".xp__card").forEach((card) => {
      const frame = card.querySelector<HTMLIFrameElement>(".xp__embed");
      if (!frame) return;
      card.addEventListener("mouseenter", () => {
        try { (frame.contentWindow as Window & { replay?: () => void })?.replay?.(); } catch {}
      });
    });
  }
</script>

<script>
  // 2m+ tile hover: build the blue dots as real elements so they can change colour one by one, like the 50+ grid. Hover-capable screens only.
  const host = document.querySelector<HTMLElement>("[data-dot-grid]");
  if (host && matchMedia("(hover: hover)").matches) {
    const build = () => {
      const cols = Math.ceil(host.clientWidth / 18);
      const rows = Math.ceil(host.clientHeight / 18);
      host.style.setProperty("--cols", String(cols));
      host.style.setProperty("--step", `${780 / Math.max(1, cols + rows - 2)}ms`);
      const frag = document.createDocumentFragment();
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const i = document.createElement("i");
        i.style.setProperty("--d", String(c + r));
        frag.append(i);
      }
      host.replaceChildren(frag);
      host.parentElement?.classList.add("is-built");
    };
    let t = 0;
    new ResizeObserver(() => { clearTimeout(t); t = window.setTimeout(build, 150); }).observe(host);
  }
</script>
