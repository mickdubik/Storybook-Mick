---
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";
import Glyph from "../../components/Glyph.astro";
import Blueprint from "../../components/Blueprint.astro";
import Plate from "../../components/Plate.astro";
import Shot from "../../components/Shot.astro";
import SmartTrafficDemo from "../../components/demos/SmartTrafficDemo.astro";
import DocPortalDemo from "../../components/demos/DocPortalDemo.astro";
import DoctorOnlineDemo from "../../components/demos/DoctorOnlineDemo.astro";
import { Image } from "astro:assets";
import dsStrip from "../../assets/work/unbounce-design-system/ds-strip-v2.webp";
import stHero from "../../assets/work/unbounce-smart-traffic/st-hero.webp";
import ButtonStates from "../../components/ButtonStates.astro";
import ResultsTable from "../../components/ResultsTable.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import { caseStudies, type CaseStudy } from "../../data/work";

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props { study: CaseStudy }
const { study: c } = Astro.props;
const i = caseStudies.findIndex((x) => x.slug === c.slug);
const next = caseStudies[(i + 1) % caseStudies.length];
const prev = caseStudies[(i - 1 + caseStudies.length) % caseStudies.length];
// The "How measured" lines are hidden for now (owner, 2026-10-19). The data stays on each case in work.ts (`measured`): set this to true to bring them back.
const SHOW_MEASURED = false;
// Prototype (2026-10-23, not published): the cover is the hero picture, Apple-style, on this case first.
const heroStrips: Record<string, { src: ImageMetadata; alt: string; ar: number }> = {
  "unbounce-design-system": { src: dsStrip, alt: "The four parts of the system: colour, typography, tokens and components.", ar: 4.18 },
  "unbounce-smart-traffic": { src: stHero, alt: "The All Pages list in Unbounce: two pages with their visitors, conversions and rating, and the Page Performance popover comparing a 2% conversion rate with the 5.2% industry average and 17.1% estimated with Smart Traffic.", ar: 2000 / 750 },
};
const heroPic = heroStrips[c.slug];
// On the Design system case the full overview image moves into the body, between chapters 07 and 08.
const coverMoved = c.slug === "unbounce-design-system";
// Blueprint marks (owner, 2026-11-10): the design-system case only, for now (header, In brief, Impact and the chapters).
const bp = c.slug === "unbounce-design-system";
// Doc portal and Doctor Online place their full animation inside a chapter (a `demo` block) instead of as the cover below "Impact".
const demoInChapter = c.chapters.some((ch) => ch.blocks.some((b) => b.t === "demo"));
// The headline result leads the Impact bento; the others follow.
const leadMetric = c.metrics.find((m) => m.value === c.headline.value && m.label === c.headline.label) ?? c.metrics[0];
const restMetrics = c.metrics.filter((m) => m !== leadMetric);
const nn = (n: number) => String(n + 1).padStart(2, "0");
const fmt = (n: number, unit: string) => `${n}${unit}`;
const metricText = (m: { qualifier?: string; value: string; unit: string; label: string }) =>
  `${m.qualifier ? m.qualifier + " " : ""}${m.value}${m.unit} ${m.label.toLowerCase()}`;
// The impact figure that morphs from the home list is the case's headline, wherever it sits in the band.
const isHeadline = (m: { value: string; label: string }) => m.value === c.headline.value && m.label === c.headline.label;
---

<Base
  title={`${c.company}: ${c.product} | Mick Dubik case study`}
  description={`${c.dek} ${c.metrics.map(metricText).join(", ")}.`}
  ogType="article"
  ogImage={`/og/${c.slug}.png`}
  ogImageAlt={`${c.company} ${c.product} case study: ${c.headline.qualifier ? c.headline.qualifier + " " : ""}${c.headline.value}${c.headline.unit} ${c.headline.label.toLowerCase()}.`}
  contactHeading={["Want results like these", "on your product?"]}
  contactSubject={`Project enquiry (via ${c.company} ${c.product} case study)`}
>
  <article class="study">
    {/* ============ Header ============ */}
    <header class={`study__head${bp ? " bp-host" : ""}`}>
      {bp && <Blueprint top={false} />}
      <div class="wrap">
        <div class="study__first">
        {c.demo === "smartTraffic" && <div class="study__bg"><SmartTrafficDemo backdrop /></div>}
        {c.demo === "docPortal" && <div class="study__bg study__bg--third study__bg--stack"><DocPortalDemo backdrop stack /></div>}
        {c.demo === "doctorOnline" && <div class="study__bg study__bg--third study__bg--strips"><DoctorOnlineDemo backdrop /></div>}
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a class="link" href="/#work">All work</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Case {c.index} of {String(caseStudies.length).padStart(2, "0")}</span>
        </nav>
        <p class="study__co mono">{c.company} · {c.product}</p>
        <h1 class="study__title" style={`view-transition-name: title-${c.slug}`}>{c.title}</h1>
        {/* Hero = title, subtitle, result. Everything else (problem, my part, the facts) comes after a generous gap. */}
        {!heroPic && <p class="lede study__sub">{c.dek}</p>}
        {heroPic && (
          <div class={`study__pic${coverMoved ? "" : " study__pic--shot"}${c.demo === "smartTraffic" ? " study__pic--mobile" : ""}`} style={`--cover-ar: ${heroPic.ar}`}>
            {c.demo === "smartTraffic" ? <SmartTrafficDemo backdrop /> : <Image src={heroPic.src} alt={heroPic.alt} widths={[900, 1400, 2000, 2851]} sizes="(min-width: 1440px) 1328px, 92vw" loading="eager" />}
          </div>
        )}
        {/* Puts the outcome on the first screen at every width (round 6: now also at 1440, where the impact band
             starts below the fold). It repeats the band's headline figure, so it is hidden from assistive tech. */}
        <p class="study__headline" aria-hidden="true">
          <span class="figure-num">{c.headline.qualifier && <span class="mono study__headline-q">{c.headline.qualifier}</span>}{c.headline.value}{c.headline.unit}</span>
          <span class="study__headline-label">{c.headline.label.charAt(0).toLowerCase() + c.headline.label.slice(1)}</span>
        </p>
        </div>
        {/* After the gap: the facts. The problem, my part and the outcome are told once, in "In brief" below (they used to be repeated here). */}
        <div class="study__facts">
          <dl class="meta meta--row">
            {c.meta.filter((m) => m.label !== "Scope").map((m) => (
              <div>
                <dt class="mono">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </header>

    {/* ============ In brief: problem → my call → outcome ============ */}
    <section class={`brief${bp ? " bp-host" : ""}`} aria-labelledby="brief-title">
      {bp && <Blueprint />}
      <div class="wrap sheet">
        <div class="rail"><h2 id="brief-title" class="rail-label"><span aria-hidden="true">[</span>In brief<span aria-hidden="true">]</span></h2></div>
        <dl class="body brief__rows">
          <div class="brief__row">
            <dt class="mono">Problem</dt>
            <dd>{c.brief.problem}</dd>
          </div>
          <div class="brief__row brief__row--call">
            <dt class="mono">My part</dt>
            <dd>
              <p>{c.part}</p>
              <p>{c.brief.call}</p>
            </dd>
          </div>
          <div class="brief__row brief__row--out">
            <dt class="mono">Outcome</dt>
            <dd>{c.brief.outcome}</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* ============ Impact: a bento grid (2026-10-24), the headline result large, the others around it ============ */}
    <section class={`impact${bp ? " bp-host" : ""}`} aria-labelledby="impact-title">
      {bp && <Blueprint />}
      <div class="wrap">
        <h2 id="impact-title" class="impact__title mono"><span aria-hidden="true">[</span>Impact<span aria-hidden="true">]</span></h2>
        <div class="impact__bento">
          {[leadMetric, ...restMetrics].map((m, k) => (
            <div class={`impact__item reveal${k === 0 ? " impact__item--lead" : ""}`}>
              {k === 0 && <span class="mono impact__tag">Headline result</span>}
              <span class="mono impact__qual">{m.qualifier ?? " "}</span>
              <span class="figure-num impact__num" data-count style={k === 0 ? `view-transition-name: fig-${c.slug}` : undefined}>
                {m.value}{m.unit}
              </span>
              <span class="impact__label fig-label">{m.label}</span>
              <Glyph metric={m} />
            </div>
          ))}
        </div>
        {SHOW_MEASURED && c.measured && <p class="measured mono impact__measured"><span>How measured</span> {c.measured}</p>}
      </div>
    </section>

    {/* ============ Cover ============ */}
    {!coverMoved && !demoInChapter && <div class="wrap study__cover" style={`--cover-ar: ${c.demo || !c.cover ? 1.6 : c.cover.w / c.cover.h}`}>
      {/* The cover spans the full .wrap: 92vw up to the 1440px max (1328px of content). */}
      {c.demo === "doctorOnline" ? <DoctorOnlineDemo /> : c.demo === "docPortal" ? <DocPortalDemo /> : c.demo === "smartTraffic" ? <SmartTrafficDemo caption="Page Performance, from the list. Each page now gets a rating and a lightbulb; hovering it shows how the page compares with its industry." /> : <Shot img={c.cover} sizes="(min-width: 1920px) 1728px, (min-width: 1440px) 1296px, 92vw" />}
    </div>}

    {/* ============ Body ============ */}
    <div class={`wrap sheet study__body${bp ? " bp-host" : ""}`}>
      {bp && <Blueprint />}
      <aside class="rail">
        <nav class="toc" aria-label="On this page">
          <p class="mono toc__title"><span aria-hidden="true">[</span>On this page<span aria-hidden="true">]</span></p>
          <ol>
            {c.chapters.map((ch, n) => (
              <li><a href={`#${ch.id}`} data-toc={ch.id}><span class="mono" aria-hidden="true">{nn(n)}</span>{ch.title}</a></li>
            ))}
          </ol>
        </nav>
        <details class="jump" data-soft-close>
          <summary class="mono"><span>Jump to section</span><svg class="jump__chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <ol>
            {c.chapters.map((ch, n) => (
              <li><a href={`#${ch.id}`}><span class="mono" aria-hidden="true">{nn(n)}</span>{ch.title}</a></li>
            ))}
          </ol>
        </details>
      </aside>

      <div class="body chapters">
        {c.chapters.map((ch, n) => (
          <>
          <section id={ch.id} class="chapter" aria-labelledby={`${ch.id}-h`} data-chapter>
            <h2 id={`${ch.id}-h`} class="chapter__h"><span class="mono" aria-hidden="true">{nn(n)}</span>{ch.title}</h2>
            {ch.blocks.map((b) => (
              <div class={`block block--${b.t}`}>
                {b.t === "statement" && <p class="chapter__statement">{b.text}</p>}

                {b.t === "prose" && <div class="prose">{b.paras.map((p) => <p>{p}</p>)}</div>}

                {b.t === "list" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <ul class="checklist">{b.items.map((it) => <li>{it}</li>)}</ul>
                  </>
                )}

                {b.t === "lists" && (
                  <div class="lists">
                    {b.groups.map((g) => (
                      <div>
                        <p class="block__label mono">{g.label}</p>
                        {g.intro && <p class="lists__intro">{g.intro}</p>}
                        <ul class="checklist">{g.items.map((it) => <li>{it}</li>)}</ul>
                      </div>
                    ))}
                  </div>
                )}

                {b.t === "stats" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <div class={b.lead ? "statsplit" : undefined}>
                    {b.lead && <div class="statsplit__lead">{b.lead.map((t) => <p>{t}</p>)}</div>}
                    <dl class={`stats${b.viz ? " stats--viz" : ""}${b.lead || b.stack ? " stats--grid" : ""}${b.stack ? " stats--stack" : ""}`}>
                      {b.items.map((s) => {
                        const pct = /^(\d+)%$/.exec(s.value);
                        const frac = /^(\d+) of (\d+)$/.exec(s.value);
                        return (
                          <div>
                            <dt class="figure-num stats__v">{s.value}</dt>
                            <dd>
                              <span class="stats__t">{s.label}</span>
                              {b.viz && pct && <span class="stats__bar" aria-hidden="true" style={`--p:${Number(pct[1]) / 100}`}></span>}
                              {b.viz && frac && <span class="stats__dots" aria-hidden="true">{Array.from({ length: Number(frac[2]) }, (_, k) => <i class={k < Number(frac[1]) ? "on" : ""}></i>)}</span>}
                            </dd>
                          </div>
                        );
                      })}
                    </dl>
                    </div>
                  </>
                )}

                {b.t === "personas" && (
                  <div class="jobs">
                    {b.items.map((p) => (
                      <div class="job">
                        <div class="job__who">
                          <h3 class="job__name">{p.name}</h3>
                          <p class="job__desc">{p.desc}</p>
                        </div>
                        <span class="job__rule" aria-hidden="true"></span>
                        <div class="job__job">
                          <p class="job__k mono">Job to be done</p>
                          <p class="job__jtbd">{p.jtbd}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {b.t === "cards" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <dl class={`cards${b.numbered ? " cards--row" : ""}`}>
                      {b.items.map((p) => (
                        <div>
                          <dt>{p.title}</dt>
                          <dd>{p.body}</dd>
                        </div>
                      ))}
                    </dl>
                  </>
                )}

                {b.t === "quotes" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <ul class={`quotes${b.items.length === 3 ? " quotes--row" : ""}`}>{b.items.map((q) => <li><q>{q}</q></li>)}</ul>
                  </>
                )}

                {b.t === "tags" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <ul class="tags">{b.items.map((t) => <li class="tag">{t}</li>)}</ul>
                  </>
                )}

                {b.t === "hypotheses" && (
                  <ol class="bets">
                    {b.items.map((h, k) => (
                      <li class="bet">
                        <p class="bet__area mono">
                          H{k + 1} · {h.area}
                          {h.verdict && <span class={`bet__verdict bet__verdict--${h.verdict.status.toLowerCase()}`}>{h.verdict.status}</span>}
                        </p>
                        <p class="bet__context">{h.context}</p>
                        <p class="bet__belief">{h.belief}</p>
                        {h.img && <Shot img={h.img} />}
                        <p class="block__label mono">Trade-offs</p>
                        <ul class="checklist">{h.tradeoffs.map((t) => <li>{t}</li>)}</ul>
                        {h.verdict?.reason && (
                          <>
                            <p class="block__label mono bet__why">Evidence</p>
                            <ul class="checklist bet__reason"><li>{h.verdict.reason}</li></ul>
                          </>
                        )}
                      </li>
                    ))}
                  </ol>
                )}

                {b.t === "beforeAfter" && <ComparisonTable caption="Design system metrics before and after" rows={b.rows} />}
                {b.t === "beforeAfter" && SHOW_MEASURED && c.measured && <p class="measured mono"><span>How measured</span> {c.measured}</p>}

                {b.t === "results" && b.lead && (
                  <ul class="lead">
                    {b.items.slice(0, b.lead).map((m) => (
                      <li>
                        <span class="figure-num lead__num">{m.value}{m.unit}</span>
                        <span class="lead__label">{m.label}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {b.t === "results" && <ResultsTable caption={`Reported results for ${c.product}`} items={b.items.slice(b.lead ?? 0)} />}
                {b.t === "results" && SHOW_MEASURED && c.measured && <p class="measured mono"><span>How measured</span> {c.measured}</p>}

                {b.t === "image" && <Shot img={b.img} />}

                {b.t === "gallery" && b.compare && b.imgs.length === 2 && (
                  <div class="cmp" data-cmp>
                    <div class="cmp__stack" hidden>
                      <div class="cmp__a"><Shot img={{ ...b.imgs[0], caption: undefined }} sizes="(min-width: 1200px) 1000px, 92vw" /></div>
                      <div class="cmp__b"><Shot img={{ ...b.imgs[1], caption: undefined }} sizes="(min-width: 1200px) 1000px, 92vw" /></div>
                      <span class="cmp__tag cmp__tag--a mono" aria-hidden="true">{b.imgs[0].caption}</span>
                      <span class="cmp__tag cmp__tag--b mono" aria-hidden="true">{b.imgs[1].caption}</span>
                      <span class="cmp__handle" aria-hidden="true"></span>
                      <input class="cmp__range" type="range" min="0" max="100" value="50" aria-label={`Compare ${b.imgs[0].caption?.toLowerCase()} and ${b.imgs[1].caption?.toLowerCase()}: move to reveal`} />
                    </div>
                    <div class="gallery cmp__fallback">{b.imgs.map((img) => <Shot img={img} />)}</div>
                  </div>
                )}
                {b.t === "gallery" && !b.compare && (
                  <div class:list={["gallery", b.wide && "gallery--wide"]}>{b.imgs.map((img) => <Shot img={img} />)}</div>
                )}

                {b.t === "demo" && (
                  <div class="block__demo" style="--cover-ar: 1.6">
                    {b.demo === "smartTraffic" ? <SmartTrafficDemo caption={b.caption} /> : b.demo === "docPortal" ? <DocPortalDemo /> : <DoctorOnlineDemo />}
                  </div>
                )}

                {b.t === "plate" && <Plate variant={b.variant} title={b.title} caption={b.caption} note={b.note} />}

                {b.t === "tokenChain" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <ol class="chain">
                      {b.steps.map((st) => (
                        <li class="chain__step">
                          <span class="chain__kind mono">{st.kind}</span>
                          <code class="chain__name">
                            {st.swatch && <i class="chain__sw" style={`background:${st.swatch}`} aria-hidden="true"></i>}
                            <span>{st.name.split("/").map((part, k) => (k ? <><wbr />/{part}</> : part))}</span>
                          </code>
                          <span class="chain__hint">{st.hint}</span>
                        </li>
                      ))}
                    </ol>
                    <p class="chain__note">{b.note}</p>
                  </>
                )}

                {b.t === "decision" && (
                  <>
                    {b.label && <p class="block__label mono">{b.label}</p>}
                    <p class="decision__lead">{b.lead}</p>
                    <div class="decision">
                      {b.options.map((o) => (
                        <div class={`decision__opt${o.chosen ? " is-chosen" : ""}`}>
                          <p class="decision__tag mono">{o.tag}</p>
                          <h3 class="decision__title">{o.title}</h3>
                          {o.body && <p class="decision__body">{o.body}</p>}
                          {o.points && <ul class="decision__points">{o.points.map((pt) => <li>{pt}</li>)}</ul>}
                        </div>
                      ))}
                    </div>
                  </>
                )}

                {b.t === "buttonStates" && <ButtonStates title={b.title} caption={b.caption} note={b.note} />}
              </div>
            ))}
          </section>
          {coverMoved && ch.id === "adoption" && (
            <figure class="chapter-pic">
              <Shot img={c.cover} sizes="(min-width: 1440px) 1000px, 92vw" />
            </figure>
          )}
          </>
        ))}
      </div>
    </div>

    {/* ============ Pager ============ */}
    <nav class="pager" aria-labelledby="pager-h">
      <div class="wrap">
        <h2 id="pager-h" class="pager__h mono"><span aria-hidden="true">[</span>Explore even more<span aria-hidden="true">]</span></h2>
      </div>
      <div class="wrap pager__inner">
        {[{ d: prev, k: "← Previous case", cls: "" }, { d: next, k: "Next case →", cls: " pager__link--next" }].map(({ d, k, cls }) => (
          <a class={`pager__link${cls}`} href={`/work/${d.slug}`}>
            <span class="mono">{k}</span>
            <span class="pager__fig">
              <span class="figure-num pager__num">
                {d.headline.qualifier && <span class="mono pager__q">{d.headline.qualifier} </span>}{d.headline.value}{d.headline.unit}
              </span>
              <span class="pager__label">{d.headline.label.charAt(0).toLowerCase() + d.headline.label.slice(1)}</span>
            </span>
            <span class="pager__title">{d.company}: {d.product}</span>
          </a>
        ))}
      </div>
    </nav>
  </article>

</Base>

<script>
  // Before / after slider: reveal the second image from the left as the range moves.
  document.querySelectorAll<HTMLElement>("[data-cmp]").forEach((root) => {
    const range = root.querySelector<HTMLInputElement>(".cmp__range");
    const stack = root.querySelector<HTMLElement>(".cmp__stack");
    if (!range || !stack) return;
    const set = () => stack.style.setProperty("--pos", range.value + "%");
    range.addEventListener("input", set);
    set();
    stack.hidden = false;
    root.classList.add("is-ready");
  });
  // Current-section state for the table of contents.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-toc]").forEach((a) => links.set(a.dataset.toc!, a));
  const setCurrent = (id: string) => {
    links.forEach((a, key) => (key === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
  };
  // A reading band 35–45% down the viewport: the chapter crossing it is the one being read.
  // (Round 4: the old top-edge band lagged a section behind the heading in view.)
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const inBand = new Set<string>();
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => (e.isIntersecting ? inBand.add(e.target.id) : inBand.delete(e.target.id)));
      const current = chapters.filter((ch) => inBand.has(ch.id)).pop();
      if (current) setCurrent(current.id);
    },
    { rootMargin: "-35% 0px -55% 0px" }
  );
  chapters.forEach((s) => io.observe(s));
  // Close the mobile jump menu after choosing a section.
  document.querySelectorAll<HTMLAnchorElement>(".jump a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open"))
  );
</script>

<style>
  /* ---------- Header ---------- */
  .study__head { --bp-t: 0px; --bp-b: clamp(56px, 8vw, 112px); padding-block: clamp(4px, 1vw, 12px) var(--bp-b); } /* --bp-t is 0: the blueprint frame starts at the site header's bottom edge, which is its top line */
  .crumbs { display: flex; align-items: center; gap: 10px; color: var(--color-text-muted); margin-bottom: clamp(20px, 3.4vw, 44px); }
  .crumbs a { color: var(--color-text-default); display: inline-flex; align-items: center; min-height: 44px; }
  .study__co { color: var(--color-text-muted); margin-bottom: 18px; }
  .study__title {
    font-family: var(--font-family-sans);
    font-weight: 700;
    font-size: var(--font-size-h1);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 22ch;
    text-wrap: balance;
  }
  /* Headline figure under the title, so the outcome is on the first screen at every width. */
  .study__headline {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: clamp(32px, 4vw, 48px);
  }
  .study__sub { margin-top: clamp(20px, 2.4vw, 28px); max-width: var(--size-measure); }
  .study__headline .figure-num { font-size: clamp(2.8rem, 2rem + 4vw, 3.6rem); }
  .study__headline-q { font-size: var(--font-size-micro); color: var(--color-text-muted); margin-right: 8px; letter-spacing: 0.04em; vertical-align: top; line-height: 1; position: relative; top: 0.5em; }
  .study__headline-label { color: var(--color-text-secondary); }
  @media (min-width: 960px) {
    .study__headline { flex-wrap: nowrap; }
    .study__headline .figure-num { font-size: clamp(3.2rem, 2rem + 2.6vw, 4.8rem); }
  }


  .study__facts { margin-top: clamp(72px, 10vw, 136px); display: grid; gap: 28px; } /* negative space: the hero stands alone */
  .meta.meta--row { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 28px 32px; padding-top: 0; border-top: 0; }
  /* each fact is its own group: a hairline above it, label and value tight beneath, aligned to the top of the group */
  .meta.meta--row div { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; align-content: start; padding: 14px 0 0; border: 0; border-top: 1px solid var(--color-border-strong); }
  .meta.meta--row dd { color: var(--color-text-default); font-size: var(--font-size-body); line-height: 1.4; }
  .meta { border-top: 1px solid var(--color-border-strong); }
  .meta div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 12px;
    padding-block: 11px;
    border-bottom: 1px solid var(--color-border-default);
  }
  .meta dt { color: var(--color-text-muted); padding-top: 0.2em; }

  /* ---------- In brief ---------- */
  .brief { --bp-t: clamp(44px, 6vw, 96px); --bp-b: var(--bp-t); padding-block: var(--bp-t) var(--bp-b); } /* no section rule: the bracketed label and the spacing separate it, like the Impact bento below */
  .brief .rail-label { display: block; position: static; margin: 0 0 16px; font-weight: 400; }
  .brief__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 6px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-border-default);
  }
  .brief__row:first-child { padding-top: 12px; }
  @media (min-width: 960px) {
    .brief__row { grid-template-columns: 8.5rem minmax(0, 1fr); }
    .brief__row:first-child { padding-top: 0; }
  }
  .brief__row dt { color: var(--color-text-muted); padding-top: 0.35em; }
  .brief__row dd { color: var(--color-text-secondary); max-width: var(--size-measure); text-wrap: pretty; }
  /* The call is body copy; only the outcome is set large, so the two do not compete. */
  .brief__row--out dd {
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: var(--font-size-lede);
    line-height: 1.32;
    letter-spacing: -0.012em;
    color: var(--color-text-default);
    max-width: 48ch;
  }
  .brief__row dd p + p { margin-top: 12px; } /* my part: what I covered, then the call I made, one row */
  .brief__row--out { border-bottom: 0; padding-top: 24px; }

  /* ---------- Impact ---------- */
  .impact { --bp-t: clamp(48px, 6vw, 88px); --bp-b: var(--bp-t); padding-block: var(--bp-t) var(--bp-b); }
  .impact__title { margin-bottom: clamp(20px, 2.4vw, 32px); color: var(--color-text-muted); font-weight: 400; }
  /* Bento: the headline result is the large tile on the left, the others sit in a 2-column block beside it. Same card recipe as the home "Why me" tiles. */
  .impact__bento { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .impact__bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } .impact__item--lead { grid-column: 1 / -1; } }
  @media (min-width: 1100px) {
    .impact__bento { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(150px, auto); }
    .impact__item--lead { grid-column: 1 / span 5; grid-row: 1 / span 2; }
    .impact__item:not(.impact__item--lead) { grid-column: span 3; }
    .impact__item:nth-child(2) { grid-column: 6 / span 3; }
    .impact__item:nth-child(3) { grid-column: 9 / span 4; }
    .impact__item:nth-child(4) { grid-column: 6 / span 4; }
    .impact__item:nth-child(5) { grid-column: 10 / span 3; }
    .impact__item:nth-child(4):last-child { grid-column: 6 / span 7; } /* three others: the last one runs the full width of the lower row */
  }
  .impact__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(22px, 2.4vw, 32px);
    border: 1px solid var(--color-border-default);
    border-radius: 20px;
    background: var(--color-background-card);
  }
  .impact__item { position: relative; overflow: hidden; isolation: isolate; }
  .impact__item > * { position: relative; z-index: 1; }
  /* Lead tile: the full-width result bar, a "Headline result" tag, and a quiet dot field fading in from the top right, the same language as the home "Why me" tiles. */
  .impact__item--lead { justify-content: flex-end; min-height: 300px; }
  .impact__item--lead::before { content: ""; position: absolute; inset: 0; z-index: 0; opacity: 0.2; pointer-events: none;
    background: radial-gradient(circle, var(--color-text-default) 1.1px, transparent 1.6px) 0 0 / 18px 18px;
    -webkit-mask-image: radial-gradient(130% 100% at 100% 0%, #000 0%, transparent 65%); mask-image: radial-gradient(130% 100% at 100% 0%, #000 0%, transparent 65%); }
  .impact__item > .impact__tag { position: static; margin-bottom: auto; padding-bottom: 20px; color: var(--color-text-muted); } /* in the flow, at the top of the tile: it can never run into the figure's qualifier */
  .impact__item--lead :global(.glyph) { max-width: 100%; margin-top: 14px; }
  .impact__item--lead .impact__num { font-size: var(--font-size-figure); }
  @media (hover: hover) { .impact__item { transition: border-color 200ms ease; } .impact__item:hover { border-color: var(--color-text-muted); } }
  .impact__qual { color: var(--color-text-muted); min-height: 1.2em; }
  .impact__num { font-size: var(--font-size-figure-sm); }
  .impact__label { margin-bottom: 6px; max-width: 28ch; }

  /* Hero picture (prototype): centred under the result, grows from 92% to full size and rises into place as it scrolls in (CSS scroll-driven, transform/opacity only; static without support or with reduced motion). */
  .study__pic { margin: clamp(36px, 5vw, 64px) auto 0; max-width: calc(40svh * var(--cover-ar, 4.18)); }
  .study__pic :global(img) { display: block; width: 100%; height: auto; }
  /* Smart Traffic: the first screen is the hero. Title top left, the result at the bottom left, and the demo is the background,
     stuck to the bottom-right corner of the screen and bleeding off its right and bottom edges. It fades in from the top-left only,
     from the left and from the top (an angled corner). It plays once and rests on the open popover. On narrower or squarer windows (under 1100px, or taller than 5:4) the still hero picture takes its place. */
  .study__bg { display: none; }
  @media (min-width: 1100px) and (min-aspect-ratio: 5/4) {
    .study__pic--mobile { display: none; }
    .study__head:has(.study__bg) { overflow-x: clip; padding-block: 0 clamp(56px, 8vw, 112px); } /* no top padding (the first screen runs under the header); keep the space under the facts */
    .study__head .wrap { position: relative; }
    /* The first screen runs under the transparent header (69px: 68px bar + 1px rule), so the picture starts at the very top of the window. */
    .study__first { --hero-h: 100svh; position: relative; display: flex; flex-direction: column; min-height: var(--hero-h); margin-top: -69px; padding-top: 69px; padding-bottom: clamp(28px, 4vw, 56px); }
    .study__first > :not(.study__bg) { position: relative; z-index: 1; }
    .study__first .study__headline { margin-top: auto; padding-top: 48px; }
    /* The picture is the full height of the first screen (16:10 frame), stuck to the bottom-right corner and bleeding off its edges. The fade runs
       corner to corner, from the top-left corner of the picture to the bottom-right, with eased stops so it is smooth. */
    .study__bg { display: block; position: absolute; right: calc(50% - 50vw); bottom: 0; width: calc(var(--hero-h) * 1.6); z-index: 0; pointer-events: none;
      --fade: linear-gradient(to bottom right, transparent 0%, transparent 28%, rgb(0 0 0 / 0.005) 34.0%, rgb(0 0 0 / 0.035) 40.0%, rgb(0 0 0 / 0.104) 46.0%, rgb(0 0 0 / 0.210) 52.0%, rgb(0 0 0 / 0.347) 58.0%, rgb(0 0 0 / 0.500) 64.0%, rgb(0 0 0 / 0.653) 70.0%, rgb(0 0 0 / 0.790) 76.0%, rgb(0 0 0 / 0.896) 82.0%, rgb(0 0 0 / 0.965) 88.0%, rgb(0 0 0 / 0.995) 94.0%, #000 100%);
      -webkit-mask-image: var(--fade); mask-image: var(--fade); }
    .study__bg :global(.std__frame::after) { display: none; }
    /* One-third variants (Doc portal, Doctor Online): the right 44% of the screen, the full height of the first screen, at 40% opacity, with no fade.
       The 16:10 animation is sized to the screen height and centred, so the third shows its middle part. */
    .study__bg.study__bg--third { width: 44vw; height: var(--hero-h); overflow: hidden; display: flex; justify-content: center; opacity: 0.4; -webkit-mask-image: none; mask-image: none; }
    .study__bg--third > :global(figure) { flex: 0 0 auto; width: calc(var(--hero-h) * 1.6); }
    /* Doctor Online: the panel shows exactly the last two strips (columns 4 and 5) of the 5-column wall, aligned to the right edge. The 16:10 wall is
       scaled so that those two columns, from the left edge of column 4 to the frame's right edge (38.5% of its width), fill the panel; the panel clips the rest. */
    .study__bg--third.study__bg--strips > :global(figure) { width: calc(44vw / 0.3854); }
    .study__bg--third.study__bg--strips { justify-content: flex-end; align-items: flex-start; }
    /* Doc portal: the screens are fitted to the panel's full width and stacked from the top. */
    .study__bg--third.study__bg--stack { align-items: flex-start; }
    .study__bg--third.study__bg--stack > :global(figure) { width: 100%; }
    /* Parallax: the picture and its fade are one layer stuck to the bottom-right corner; it lags behind the page by ~25% of the screen
       as the first screen scrolls away (CSS scroll-driven, transform only, no script). The first screen clips it vertically, not sideways. */
    .study__first { clip-path: inset(0 -100vw 0 -100vw); }
    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: scroll()) {
        .study__bg { animation-name: bg-parallax; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); animation-range: 0 var(--hero-h); }
      }
    }
    .study__head:has(.study__bg) .study__headline-label { color: var(--color-text-default); } /* the label sits on the faded picture */
    .study__head:has(.study__bg) .study__facts { margin-top: clamp(56px, 8vw, 112px); }
  }
  @keyframes bg-parallax { from { transform: translateY(0); } to { transform: translateY(calc(var(--hero-h) * 0.25)); } }
  .study__pic--shot { max-width: min(1100px, calc(40svh * var(--cover-ar, 2.67))); }
  /* Smart Traffic on narrower or squarer windows: the same animation as the wide hero (it plays once and rests on the open popover), as a framed picture under the title instead of a static crop. */
  .study__pic--mobile.study__pic--shot { max-width: min(100%, calc(58svh * 1.6)); }
  .study__pic--shot :global(img) { border-radius: 10px; box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-text-default) 14%, transparent); }
  .study__pic + .study__facts { margin-top: clamp(56px, 8vw, 112px); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .study__pic { animation-name: pic-in; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 0% entry 90%; transform-origin: 50% 0; }
    }
  }
  @keyframes pic-in { from { transform: translateY(48px) scale(0.92); opacity: 0.35; } to { transform: none; opacity: 1; } }


  /* ---------- Visual moments inside chapters ---------- */
  .lists__intro { color: var(--color-text-secondary); font-size: var(--font-size-small); margin: -4px 0 12px; max-width: var(--size-measure); }
  /* Stats with a picture of the figure: every figure has the same structure. Number on top, its meter (a bar per %, dots per "X of Y") 14px under it
     and as wide as the number, caption beside both. The dd's children join the row grid (display: contents); contain: inline-size keeps the meter from
     widening the number column, and min-width gives every number the same column so captions start at one edge. Decorative; the number stays as text. */
  .stats.stats--viz div { grid-template-rows: auto 1fr; row-gap: 14px; }
  .stats--viz dd { display: contents; }
  .stats--viz .stats__v { min-width: 2.45em; white-space: nowrap; }
  .stats--viz .stats__t { grid-column: 2; grid-row: 1 / span 2; }
  .stats--viz .stats__dots, .stats--viz .stats__bar { grid-column: 1; grid-row: 2; align-self: start; contain: inline-size; min-width: 0; }
  .stats--viz .stats__dots { justify-content: space-between; }
  .stats__bar { display: block; height: 8px; background: var(--color-background-muted); border-radius: 4px; overflow: hidden; }
  .stats__bar::after { content: ""; display: block; height: 100%; background: var(--color-accent); transform-origin: 0 50%; transform: scaleX(var(--p)); }
  .stats__dots { display: flex; gap: 6px; }
  .stats__dots i { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--color-text-muted); }
  .stats__dots i.on { background: var(--color-accent); border-color: var(--color-accent); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stats__bar::after { animation-name: bar-grow; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 10% entry 80%; }
    }
  }
  @keyframes bar-grow { from { transform: scaleX(0); } to { transform: scaleX(var(--p)); } }
  /* Principles as a numbered row */
  .cards.cards--row { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .cards.cards--row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .cards.cards--row { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px 24px; } }
  .cards--row dt { font-family: var(--font-family-sans); font-size: var(--font-size-body); line-height: 1.2; }
  @media (min-width: 1100px) { .cards--row dd { font-size: var(--font-size-small); } }
  /* Three questions side by side */
  @media (min-width: 1100px) {
    .quotes.quotes--row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; border-top: 0; max-width: none; }
    .quotes.quotes--row li { border-bottom: 0; border-top: 2px solid var(--color-text-default); padding-top: 16px; }
  }
  /* Results: the three headline figures lead, the rest follow as a table */
  .lead { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; border-top: 1px solid var(--color-border-strong); margin-bottom: 24px; max-width: 760px; }
  @media (min-width: 760px) { .lead { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: none; border-top: 0; gap: 24px; margin-bottom: 32px; } }
  .lead li { display: grid; gap: 8px; align-content: start; padding-block: 16px; border-bottom: 1px solid var(--color-border-default); }
  @media (min-width: 760px) { .lead li { border-bottom: 0; border-top: 2px solid var(--color-text-default); padding-top: 16px; } }
  .lead__num { font-size: clamp(2.8rem, 2rem + 3vw, 4.4rem); color: var(--color-accent); line-height: 1; }
  .lead__label { color: var(--color-text-secondary); max-width: 28ch; }
  /* Before / after slider: moved by the visitor (no autoplay). Without script the two images stay side by side. */
  .cmp__stack { position: relative; }
  .cmp__stack[hidden] { display: none; }
  .cmp.is-ready .cmp__stack { display: block; }
  .cmp.is-ready .cmp__fallback { display: none; }
  .cmp__b { position: absolute; inset: 0; clip-path: inset(0 0 0 var(--pos, 50%)); }
  .cmp__tag { position: absolute; top: 16px; padding: 4px 10px; border-radius: 999px; background: var(--color-background-default); color: var(--color-text-default); font-size: var(--font-size-micro); box-shadow: 0 0 0 1px var(--color-border-default); }
  .cmp__tag--a { left: 16px; }
  .cmp__tag--b { right: 16px; }
  .cmp__handle { position: absolute; top: 0; bottom: 0; left: var(--pos, 50%); width: 2px; margin-left: -1px; background: var(--color-background-default); box-shadow: 0 0 0 1px var(--color-text-muted); pointer-events: none; }
  .cmp__handle::after { content: ""; position: absolute; top: 50%; left: 50%; width: 36px; height: 36px; margin: -18px 0 0 -18px; border-radius: 50%; background: var(--color-background-default); box-shadow: 0 0 0 1px var(--color-text-muted), 0 2px 8px rgba(0,0,0,.18); }
  .cmp__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .cmp__stack:has(.cmp__range:focus-visible) .cmp__handle::after { box-shadow: 0 0 0 3px var(--color-accent); }
  .block__demo { max-width: calc(80svh * var(--cover-ar, 1.6)); }
  .chapter-pic { margin: 0; padding-top: clamp(40px, 6vw, 88px); }
  .study__cover { padding-top: clamp(40px, 6vw, 88px); }
  /* A static cover never grows taller than ~80% of the window (so tall images are not bigger than the screen); wide ones are unaffected. */
  @media (min-width: 960px) {
    .study__cover > :global(*) { max-width: calc(80svh * var(--cover-ar, 1.78)); margin-inline: auto; }
  }

  /* ---------- Body ---------- */
  .study__body { --bp-t: clamp(48px, 7vw, 104px); --bp-b: var(--bp-t); padding-block: var(--bp-t) var(--bp-b); }
  .toc { display: none; }
  @media (min-width: 960px) {
    .toc { display: block; position: sticky; top: calc(96px - var(--head-off, 0px)); }
    .jump { display: none; }
  }
  .toc__title { color: var(--color-text-muted); margin-bottom: 16px; }
  .toc ol, .jump ol { border-top: 1px solid var(--color-border-default); }
  .toc a, .jump a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-block: 6px;
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small);
    transition: color 200ms ease, transform 300ms var(--easing-out);
  }
  .jump a { min-height: 44px; }
  .toc a .mono, .jump a .mono { color: var(--color-text-muted); }
  .toc a[aria-current="true"] { color: var(--color-text-default); font-weight: 600; padding-left: 10px; }
  .toc a[aria-current="true"]::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 16px;
    margin-top: -8px;
    background: var(--color-text-default);
  }
  @media (hover: hover) {
    .toc a:hover { color: var(--color-accent); }
  }
  .jump { border: 1px solid var(--color-border-default); border-radius: 12px; background: var(--color-background-card); }
  .jump summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    list-style: none;
    border-radius: 12px;
    min-height: 48px;
    padding-inline: 14px;
    cursor: pointer;
    color: var(--color-text-default);
  }
  .jump summary::-webkit-details-marker { display: none; }
  .jump summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .jump__chev { flex: none; transition: transform var(--duration-default) var(--easing-out); }
  .jump[open] .jump__chev { transform: rotate(180deg); }
  @media (hover: hover) { .jump summary:hover { color: var(--color-accent); } }
  @media (prefers-reduced-motion: reduce) { .jump__chev { transition: none; } }
  .jump ol { padding: 0 14px 8px; border-top: 0; }

  .chapters { display: flex; flex-direction: column; min-width: 0; }
  .chapter {
    min-width: 0;
    padding-block: clamp(56px, 7vw, 112px); /* room to breathe between chapters (2026-10-24; was 32-56px). 240px was tried 2026-11-06 and reverted by the owner. */
    scroll-margin-top: 88px; /* no rule between chapters (2026-11-06): the space separates them */
  }
  .chapter:first-child { padding-top: 0; }
  .chapter:last-child { padding-bottom: 0; } /* the page body already pads below the last chapter */
  .chapter__h {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: var(--space-group);
    font-family: var(--font-family-sans);
    font-weight: 600;
    font-size: var(--font-size-h3);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .chapter__h .mono { color: var(--color-text-muted); }
  .block + .block { margin-top: var(--space-block); }
  .block__label { color: var(--color-text-muted); margin-bottom: 12px; }
  /* A lead statement under a chapter title: lighter and smaller than the title so the two do not fight. */
  .chapter__statement {
    font-family: var(--font-family-sans);
    font-size: var(--font-size-lede);
    font-weight: 450;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-text-secondary);
    max-width: var(--size-measure); /* 10 to 11 words per line, whatever the size */
    text-wrap: pretty;
  }

  /* A list that ends a chapter does not close with its own rule: the next chapter's rule does it, a few pixels lower. */
  .chapter > .block:last-child :is(.quotes, .checklist) > li:last-child { border-bottom: 0; }
  /* One rule for every ruled list or table: the last row has no closing line (owner, 2026-11-06). */
  .toc li:last-child a, .jump li:last-child a, .lead li:last-child, .stats > div:last-child, .quotes li:last-child, .checklist li:last-child { border-bottom: 0; }
  /* Two columns of figures: the last item of each column has no closing line, not only the very last item (owner, 2026-11-09). */
  @media (min-width: 640px) { .stats > div:nth-last-child(-n+2) { border-bottom: 0; } }
  .checklist { max-width: var(--size-measure-prose); border-top: 1px solid var(--color-border-default); }
  .checklist li {
    position: relative;
    padding: 11px 0 11px 26px;
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-secondary);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .checklist li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.35em;
    width: 12px;
    height: 1px;
