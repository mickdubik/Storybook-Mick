---
import Avail from "../components/Avail.astro";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { contact, mailto, availability, positioning, role, current, showExploration } from "../data/site";
import Analytics from "../components/Analytics.astro";
import ScrollChrome from "../components/ScrollChrome.astro";
import Portrait from "../components/Portrait.astro";
import Button from "../components/Button.astro";
// Owner logo "MD" from https://mickdubik.webflow.io (Webflow asset 677dc51438cc37f18bbc69d0), self-hosted with currentColor.
import LogoMark from "../assets/shared/logo-md.svg";
import { caseStudies } from "../data/work";
import sansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  /** The footer's closing question: [plain part, italic part]. */
  contactHeading?: [string, string];
  contactSubject?: string;
  /** Keep the page out of search results (the /system reference page). */
  noindex?: boolean;
  /** The header sits transparent at the top of the page and turns into the blurred bar once the page scrolls (every page, 2026-10-23; was home only). */
  heroHeader?: boolean;
  /** Social preview image (1200×630) under /public, e.g. "/og/home.png". */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description = "Mick Dubik, Senior Product Designer for SaaS and AI. Product experiences that scale, convert and retain users, with the numbers to show it.",
  ogType = "website",
  contactHeading = ["Bring me the problem.", "I’ll bring the numbers."],
  contactSubject = "Project enquiry",
  noindex = false,
  heroHeader = true,
  ogImage = "/og/home.png",
  ogImageAlt = "Mick Dubik, Senior Product Designer: the home page, with the name, portrait and role.",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const year = new Date().getFullYear();
const onHome = Astro.url.pathname === "/";
const h = (id: string) => (onHome ? `#${id}` : `/#${id}`);
// Footer record: one list of the work (the owner preferred it to type groups), with the headline figure per
// entry. Figures stay: the footer is reached from every case page, where the home page's figures aren't in view.
const cs = Object.fromEntries(caseStudies.map((c) => [c.slug, c]));
const entry = (slug: string, idx: string) => {
  const c = cs[slug];
  return { idx, co: c.company, name: c.shortTitle ?? c.product ?? c.title, href: `/work/${slug}`, fig: `${c.headline.value}${c.headline.unit}`, figLabel: `${c.headline.qualifier ? c.headline.qualifier + " " : ""}${c.headline.label.toLowerCase()}` };
};
const ziipLead = current.metrics[0];
const record = [
  { idx: "Now", co: current.company, name: "Current role", href: h("current"), fig: `${ziipLead.value}${ziipLead.unit}`, figLabel: ziipLead.label.toLowerCase(), cap: "courier efficiency" },
  { ...entry("unbounce-design-system", "01"), name: "Design system", cap: "up to · features/sprint" },
  { ...entry("unbounce-smart-traffic", "02"), name: "Smart Traffic", cap: "feature adoption" },
  { ...entry("datarobot-self-service-docs", "03"), name: "Self-service docs", cap: "support requests" },
  { ...entry("doctor-online-launch", "04"), name: "0 to 1 telemedicine app", cap: "concept to launch" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mick Dubik" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mick Dubik" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a09" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Mick Dubik",
      alternateName: "Nikolay Dubik",
      jobTitle: role,
      description: `${role} for SaaS and AI. ${availability}.`,
      email: `mailto:${contact.email}`,
      sameAs: [contact.linkedin],
      knowsAbout: ["Product design", "SaaS", "AI products", "Design systems"],
    })} />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={["masthead", heroHeader && "masthead--hero"]}>
      <div class:list={["wrap", "masthead__inner"]}>
        <a class="brand" href="/" aria-label="Mick Dubik, home">
          <LogoMark class="brand__mark" aria-hidden="true" />
          <span class="brand__name">Mick Dubik</span>
        </a>
        <nav class="masthead__nav" aria-label="Primary">
          <a href={h("work")}>Work</a>
          <a href={h("approach")} class="hide-sm">Approach</a>
          <a href={h("ai-workflow")} class="hide-sm">AI workflow</a>
          <a href={h("clients")} class="hide-sm">Clients</a>
          {showExploration && <a href={h("exploration")} class="hide-sm">Exploration</a>}
        </nav>
        <div class="masthead__actions">
          <button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path d="M10 2.75 A7.25 7.25 0 0 1 10 17.25 Z" fill="currentColor" />
            </svg>
          </button>
          <Button href={mailto()} size="sm" short="Contact" class="btn--inv">Discuss project</Button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* The back cover. Round 5 merges the old § Contact block into the footer so the page ends on one
         strong moment instead of two stacked closers: an inverted ink band with a display-size question, a
         portrait, the email at headline scale, then the colophon (mini-ledger of outcomes, routes out) and a
         full-width wordmark sign-off. References: mickdubik.webflow.io (structure, wordmark) and beew.studio
         (scale, inversion, contact-first); see docs/DESIGN.md. */}
    <footer class="end">
      <section class="end__cta" id="contact" aria-labelledby="contact-title">
        <div class="wrap">
          {/* Round 7: the portrait sits on the same left edge as the header logo, at a similar small scale. */}
          {/* Portrait and headline span the width; below them the lede sits left and the site links sit in the same
               columns as the record further down (7–12), so the two ruled lists line up. */}
          <div class="end__intro">
            <div class="end__me">
              <Portrait widths={[56, 112]} sizes="56px" />
              <p class="end__who">
                <span class="end__hi">Hi, I’m Mick.</span>
                <span class="end__kicker mono"><span class="live-dot" aria-hidden="true"></span><Avail /></span>
              </p>
            </div>
            <h2 id="contact-title" class="end__title reveal">{contactHeading[0]} <em>{contactHeading[1]}</em></h2>
            <p class="end__lede">Full-time or contract, with SaaS and AI teams. I lead the design and own the outcome, from first research to the metric that moved.</p>
            <nav class="end__nav" aria-labelledby="footer-links">
              <h2 id="footer-links" class="end__h mono">Links</h2>
              <ul>
                <li><a href={h("work")}>All work</a></li>
                <li><a href={h("approach")}>Approach</a></li>
                <li><a href={h("ai-workflow")}>AI workflow</a></li>
                <li><a href={h("clients")}>Clients</a></li>
                {showExploration && <li><a href={h("exploration")}>Exploration</a></li>}
              </ul>
            </nav>
          </div>
          {/* The ask at headline scale is a phrase, not the raw address (round 7); the address appears once, small,
               with a copy control. */}
          <a class="end__email" href={mailto(contactSubject)}>
            <span class="end__email-text">Email me</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
          <div class="end__addr">
            <span class="mono">Or</span>
            <span class="end__addr-text" data-copy-src>{contact.email}</span>
            <button type="button" class="end__copy" data-copy>
              <svg class="end__copy-ico end__copy-ico--copy" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.5v-.5a1.5 1.5 0 0 0-1.5-1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
              <svg class="end__copy-ico end__copy-ico--ok" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8.5 3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span data-copy-label>Copy</span><span class="sr-only"> email address</span>
            </button>
            <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
          </div>
          <div class="btn-row end__btns">
            <Button href={contact.booking} variant="secondary" icon="external" external>Book a 15-min call</Button>
            <Button href={contact.linkedin} variant="ghost" icon="external" external>LinkedIn</Button>
            <Button href={contact.resume} variant="ghost" icon="external" external>Download resume</Button>
          </div>
        </div>
      </section>

      <div class="wrap end__colophon">
        {/* Round 12: work grouped by type (after beew.studio's footer, which files case studies by what the work
            was). Categories come from the cases' own tags and facts: AI (Smart Traffic, DataRobot's AI platform),
            Design Systems (Unbounce; ZiiP's first design system, CV), MVP (Doctor Online). */}
        <div class="end__brand">
          <LogoMark class="end__markmd" aria-hidden="true" />
          <div>
            <p class="end__name">Mick Dubik<span>{role}</span></p>
            <p class="end__pos">
              <span class="end__pos-static">{positioning[0].trim().split(/(?<=\.)\s+/).map((bit) => <><span class="end__pos-bit">{bit}</span>{" "}</>)}</span>
              <span class="end__roll" aria-hidden="true" data-roll>
                <span class="end__roll-size">Support load down.</span>
                <span class="end__prism">{positioning[0].trim().split(/(?<=\.)\s+/).map((bit) => <span class="end__face">{bit}</span>)}</span>
              </span>
              <em class="end__pos-bit">{positioning[1]}</em>{positioning[2]}
            </p>
            <button type="button" class="end__replay mono" data-roll-replay>Replay sign-off</button>
          </div>
        </div>

        <nav class="end__record" aria-labelledby="footer-record">
          <h2 id="footer-record" class="end__h mono">The record</h2>
          <ol>
            {record.map((it) => (
              <li>
                <a class="end__entry" href={it.href}>
                  <span class="mono end__idx">{it.idx}</span>
                  <span class="end__entry-name">{it.co}<span class="end__entry-co"><span class="end__dot"> · </span>{it.name}</span></span>
                  <span class="end__lead" aria-hidden="true"></span>
                  <span class="end__entry-stat"><span class="figure-num end__entry-fig">{it.fig}<span class="sr-only"> {it.figLabel}</span></span><span class="end__entry-cap mono" aria-hidden="true">{it.cap}</span></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="end__meta mono">
          <p>© {year} Mick Dubik. Figures as reported by each engagement.</p>
          <a class="end__top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
        </div>
      </div>
      {/* Sign-off: the header lockup (owner's MD mark + name), scaled to the full page width, as beew.studio
           echoes its header logotype in its footer. Decorative. */}
      <p class="end__mark" aria-hidden="true"><span>Mick Dubik</span></p>
    </footer>

    <script>
      // Copy the email address (footer). Both outcomes are announced through the live region.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
        const label = b.querySelector<HTMLElement>("[data-copy-label]")!;
        b.addEventListener("click", async () => {
          const wrap = b.parentElement!;
          const src = wrap.querySelector<HTMLElement>("[data-copy-src]")!;
          const status = wrap.querySelector<HTMLElement>("[data-copy-status]")!;
          const say = (btnText: string, msg: string, ok: boolean) => {
            label.textContent = btnText;
            status.textContent = msg;
            if (ok) b.dataset.state = "copied";
            setTimeout(() => { label.textContent = "Copy"; status.textContent = ""; delete b.dataset.state; }, 2000);
          };
          try {
            await navigator.clipboard.writeText(src.textContent ?? "");
            say("Copied", "Email address copied", true);
          } catch {
            const r = document.createRange();
            r.selectNodeContents(src);
            getSelection()?.removeAllRanges();
            getSelection()?.addRange(r);
            say("Select to copy", "Email address selected. Press Ctrl+C or Command+C to copy.", false);
          }
        });
      });

      // Soft close for <details data-soft-close>: a native details closes instantly, so the content fades out
      // and lifts 6px (150ms) before the row closes. In an exclusive group (name=), the open row closes first,
      // then the new one opens. Reduced motion: native behaviour.
      const softClose = (d: HTMLDetailsElement) => {
        const parts = [...d.children].filter((c) => c.tagName !== "SUMMARY") as HTMLElement[];
        if (!parts.length) { d.open = false; return Promise.resolve(); }
        return Promise.all(
          parts.map((p) => p.animate(
            [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-6px)" }],
            { duration: 150, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          ).finished)
        ).then(() => { d.open = false; }).catch(() => { d.open = false; });
      };
      document.querySelectorAll<HTMLDetailsElement>("details[data-soft-close]").forEach((d) => {
        const sum = d.querySelector("summary");
        sum?.addEventListener("click", (e) => {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          e.preventDefault();
          if (d.open) { softClose(d); return; }
          const group = d.getAttribute("name");
          const others = group ? [...document.querySelectorAll<HTMLDetailsElement>(`details[name="${group}"][open]`)].filter((o) => o !== d) : [];
          if (others.length) Promise.all(others.map(softClose)).then(() => { d.open = true; });
          else d.open = true;
        });
      });

      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const sync = () => btn?.setAttribute("aria-pressed", String(current() === "dark"));
      sync();
      btn?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.setAttribute("data-theme-fade", "");
          window.setTimeout(() => root.removeAttribute("data-theme-fade"), 260);
        }
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
      });
    </script>

    <style>
      /* Sticky header: solid by default, so content never shows through. Where the browser supports
         backdrop blur, it turns slightly translucent with a strong blur (progressive enhancement). One filter
         function only: the CSS minifier was joining "saturate(1.2) blur(12px)" into an invalid value. Users who
         ask for reduced transparency always get the solid header. */
      /* Sticky, and moved by ScrollChrome: it leaves with the page and returns quickly on an upward scroll. */
      .masthead {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--paper);
        border-bottom: 1px solid var(--rule);
      }
      @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .masthead {
          background: color-mix(in srgb, var(--paper) 82%, transparent);
          -webkit-backdrop-filter: blur(20px);
          backdrop-filter: blur(20px);
        }
      }
      @media (prefers-reduced-transparency: reduce) {
        .masthead { background: var(--paper); -webkit-backdrop-filter: none; backdrop-filter: none; }
      }
      .masthead__inner {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
        min-height: 68px;
      }
      /* Lockup (round 9): the owner's MD mark at its exact original geometry, tight viewBox (clear space comes from
         the gap, not from padding baked into the SVG), sized to an integer 14px height so its horizontals land on
         the pixel grid, and baseline-aligned with the name: the mark's bottom sits on the text baseline and
         overshoots the Geist cap height (~11.5px) slightly, as the original did against Montserrat. No separator. */
      .brand { display: inline-flex; align-items: baseline; gap: 10px; padding-block: 14px 13px; }
      .brand__mark { display: block; height: 14px; width: auto; flex: none; color: var(--ink); transition: color 200ms ease; }
      @media (hover: hover) { .brand:hover .brand__mark { color: var(--signal); } }
      .brand__name { font-size: 1rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1; white-space: nowrap; }
      /* Very narrow phones: the mark alone (the link keeps its aria-label), so the logo, the theme toggle and the button fit the gutters. */
      @media (max-width: 345px) { .brand__name { display: none; } }
      .masthead__nav {
        display: flex;
        justify-content: center;
        gap: clamp(14px, 2.5vw, 36px);
        font-size: var(--t-small);
      }
      .masthead__nav a { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; color: var(--ink-2); transition: color 200ms ease; }
      @media (hover: hover) { .masthead__nav a:hover { color: var(--signal); } }
      .masthead__actions { display: flex; align-items: center; gap: 10px; justify-self: end; }
      .brand { justify-self: start; }
      /* Home: the header sits transparent over the hero (which slides up under it) until the page scrolls, and its
         content stands on the hero's own margins, so the logo lines up with the name and the button with the right edge. */
      .masthead--hero { transition: background-color 300ms ease, border-color 300ms ease, backdrop-filter 300ms ease, -webkit-backdrop-filter 300ms ease; }
      .masthead--hero:not(.is-scrolled) { background: transparent; border-bottom-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }

      /* Icon-only button: just the icon at rest (no outline); the button's own shape appears on hover as a
         low-contrast fill (8% ink), at the same 12px radius as the small buttons. 44px target. */
      .theme-toggle {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--ink);
        cursor: pointer;
        transition: background-color 200ms ease, transform 160ms var(--ease-out);
      }
      .theme-toggle:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
      .theme-toggle:active { transform: scale(0.97); }
      @media (prefers-reduced-motion: reduce) { .theme-toggle:active { transform: none; } }

      @media (max-width: 1040px) {
      }
      @media (max-width: 720px) {
        .hide-sm { display: none; }
        .masthead__nav { justify-content: flex-end; }
      }
      /* Below 760px the nav can't fit beside the lockup and the button without wrapping or crowding the name;
         the same links sit in the footer. */
      @media (max-width: 760px) {
        .masthead__nav { display: none; }
        .masthead__inner { grid-template-columns: auto 1fr auto; }
        .masthead__actions { grid-column: 3; }
      }
      /* ================= The back cover (footer) =================
         The band re-declares the core tokens, so buttons, links, focus rings and figures all invert with it.
         Light theme: ink band on a paper page. Dark theme (round 6): a lifted warm-grey surface (#2c2b27 on the
         #10100f page) under a full-strength paper rule, so the page visibly turns over in both themes. */
      /* Footer follows the site theme, like the header: page colours in light and dark, separated from the
         content above by a top rule (the header mirrors this with its bottom rule). */
      .end {
        --end-gap: clamp(56px, 6.7vw, 96px); /* one gap between footer groups (2026-11-06); fine print and wordmark use half */
        container-type: inline-size; /* lets the sign-off size to the footer width (cqi), not 100vw with scrollbar */
        position: relative;
        overflow: hidden;
        background: var(--paper);
        color: var(--ink);
        border-top: 1px solid var(--rule);
      }

      .end__cta { --bp-t: clamp(56px, 10vw, 152px); --bp-b: 0px; padding-block: var(--bp-t) var(--bp-b); }
      .end__kicker { display: inline-flex; align-items: center; gap: 10px; color: var(--ink-2); }

      .end__title {
        margin-top: clamp(28px, 4vw, 48px);
        font-family: var(--font-sans);
        font-weight: 700;
        font-size: var(--t-display);
        line-height: 0.94;
        letter-spacing: -0.04em;
        max-width: 28ch; /* wide enough for each sentence on one line at desktop; wraps, balanced, on phones */
        text-wrap: balance;
      }
      .end__title em { display: block; font-style: normal; color: var(--hero-grey); } /* the answer starts its own line */

      /* Portrait row: same left edge as the header logo; 56px, matching the hero avatar. */
      .end__me { display: flex; align-items: center; gap: 16px; }
      .end__me :global(img) {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #d9d5cc;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
      }
      .end__who { display: flex; flex-direction: column; gap: 4px; }
      .end__hi { font-family: var(--font-sans); font-weight: 600; font-size: var(--t-lede); letter-spacing: -0.02em; line-height: 1.1; }

      .end__lede { margin-top: clamp(16px, 2vw, 24px); max-width: 44ch; font-size: var(--t-body); line-height: 1.5; color: var(--ink-3); text-wrap: pretty; }

      /* The ask at headline scale: "Email me ↗" as one big mailto (round 7: a phrase, not the raw address). */
      .end__email {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.3em;
        margin-top: calc(var(--end-gap) - clamp(10px, 1.6vw, 22px)); /* the visible gap above the big link = --end-gap */
        padding-block: clamp(10px, 1.6vw, 22px) clamp(14px, 2vw, 28px);
        /* no rule above the email link (2026-11-06): the intro text already separates it */
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: clamp(2.6rem, 1rem + 6.4vw, 7.4rem);
        letter-spacing: -0.045em;
        line-height: 1;
        color: var(--ink);
        transition: color 250ms ease;
      }
      .end__email-text {
        background-image: linear-gradient(currentColor, currentColor);
        background-size: 0% 2px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        padding-bottom: 0.06em;
        transition: background-size 600ms var(--ease-out);
      }
      .end__email svg { width: 0.55em; height: 0.55em; flex: none; transition: transform var(--dur) var(--ease-out); }
      .end__email:hover, .end__email:focus-visible { color: var(--signal); }
      .end__email:hover .end__email-text, .end__email:focus-visible .end__email-text { background-size: 100% 2px; }
      .end__email:hover svg, .end__email:focus-visible svg { transform: translate(8px, -8px); }
      .end__addr {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 10px;
        padding-block: 6px 16px;
        border-bottom: 1px solid var(--rule);
        color: var(--ink-2);
      }
      .end__addr .mono { color: var(--ink-3); }
      .end__addr-text { font-size: var(--t-small); user-select: all; overflow-wrap: anywhere; }
      /* Copy (round 11): a small ghost control right after the address; icon + "Copy", swapping to a check +
         "Copied" for 2s. The visible control is compact; a pseudo-element keeps the hit area at 44px. */
      .end__copy {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        border: 1px solid var(--rule);
        border-radius: 8px;
        background: transparent;
        color: var(--ink-2);
        font: inherit;
        font-size: var(--t-label);
        cursor: pointer;
        transition: color 200ms ease, border-color 200ms ease, background-color 200ms ease;
      }
      .end__copy::before { content: ""; position: absolute; inset: -10px -6px; }
      .end__copy:hover, .end__copy:focus-visible { color: var(--signal); border-color: currentColor; }
      .end__copy-ico { width: 14px; height: 14px; flex: none; }
      .end__copy-ico--ok { display: none; }
      .end__copy[data-state="copied"] { color: var(--signal); border-color: currentColor; }
      .end__copy[data-state="copied"] .end__copy-ico--copy { display: none; }
      .end__copy[data-state="copied"] .end__copy-ico--ok { display: block; }
      .end__btns { margin-top: clamp(24px, 3vw, 36px); }
      /* Intro + site links: intro on the left, links on the right, set as a ruled list like the record. */
      .end__intro { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--col-gap); }
      .end__nav { margin-top: 32px; }
      @media (min-width: 960px) {
        /* Same 12-column grid and gap as the colophon, so the links (7–12) align with the record. */
        .end__intro { grid-template-columns: repeat(12, minmax(0, 1fr)); }
        .end__me, .end__title { grid-column: 1 / -1; }
        .end__lede { grid-column: 1 / span 5; align-self: start; }
        .end__nav { grid-column: 7 / -1; margin-top: clamp(16px, 2vw, 24px); }
      }
      .end__nav ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--col-gap); border-top: 1px solid var(--rule-strong); }
      .end__nav li { border-bottom: 1px solid var(--rule); }
      .end__nav li:last-child, .end__nav li:nth-last-child(2) { border-bottom: 0; } /* last row of each of the two columns: no closing line (owner, 2026-11-06) */
      .end__record li:last-child .end__entry { border-bottom: 0; }
      .end__nav a { display: flex; align-items: center; min-height: 52px; color: var(--ink); font-weight: 500; white-space: nowrap; transition: color 200ms ease, transform 300ms var(--ease-out); }
      @media (hover: hover) { .end__nav a:hover { color: var(--signal); transform: translateX(4px); } }
      .end__nav a:focus-visible { color: var(--signal); }

      /* ---- Colophon ---- */
      /* ---- Colophon (round 12) ----
         Desktop: row 1 = brand (cols 1–5) + one compact links group (cols 8–12); row 2 = the work index in three
         type groups across the full width, one line per entry. Generous gaps, no wrapping at 1280/1440. */
      .end__colophon {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 28px var(--col-gap);
        position: relative;
        padding-top: calc(var(--end-gap) * 1.5); /* the contact block and the record are separate sections: 144px at 1440 (owner, 2026-11-06) */
      }
      /* The separator spans the content column (inside the gutters), like every other rule in the footer; a
         border on the padded box ran out into the gutters. Absolutely positioned, so it takes no grid cell. */
      .end__colophon::before {
        content: "";
        position: absolute;
        top: 0;
        left: var(--gutter);
        right: var(--gutter);
        /* no separator line (2026-11-06): the space is enough */
      }
      @media (min-width: 960px) {
        .end__colophon { grid-template-columns: repeat(12, minmax(0, 1fr)); row-gap: calc(var(--end-gap) / 2); }
        .end__brand { grid-column: 1 / span 5; }
        .end__record { grid-column: 7 / -1; }
        .end__meta { grid-column: 1 / -1; }
      }
      .end__brand { display: flex; gap: 12px; align-items: flex-start; }
      .end__markmd { height: 14px; width: auto; flex: none; margin-top: 4px; color: var(--ink); }
      .end__name { font-weight: 600; line-height: 1.35; display: flex; flex-direction: column; }
      .end__name span { font-weight: 400; color: var(--ink-3); font-size: var(--t-small); }
      .end__pos {
        position: relative;
        margin-top: 18px;
        max-width: 17ch;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: clamp(1.6rem, 1.15rem + 1.4vw, 2.3rem);
        line-height: 1.1;
        letter-spacing: -0.03em;
        text-wrap: balance;
      }
      .end__pos em { font-style: normal; color: var(--hero-grey); }
      .end__replay { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; background: none; border: 0; color: var(--ink-2); padding: 0; cursor: pointer; }
      .end__replay:focus-visible { position: static; width: auto; height: auto; overflow: visible; clip-path: none; min-height: 44px; padding: 0 4px; margin-top: 6px; text-decoration: underline; text-underline-offset: 4px; }
      @media (prefers-reduced-motion: reduce) { .end__replay { display: none; } }
      .end__pos-bit { white-space: nowrap; } /* never split a short phrase ("Retention up.") across lines */
      /* Three phrases take turns on one line, rolling up like faces of a cube. Reduced motion shows all three. */
      .end__roll { display: none; }
      @media (prefers-reduced-motion: no-preference) {
        .end__pos-static { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
        .end__pos em { display: block; }
        .end__roll { display: block; position: relative; height: 1.1em; perspective: 12em; white-space: nowrap; }
        .end__roll-size { visibility: hidden; display: block; height: 1.1em; }
        .end__prism { position: absolute; inset: 0; transform-style: preserve-3d; animation: end-roll 6s cubic-bezier(.65,0,.35,1) 2.6667 forwards paused; }
        /* a finite run (two full turns, then it rests on the last phrase): moving content that cannot be paused must stop by itself (WCAG 2.2.2). A tap or click on the line, or the Replay control for keyboards, runs it again. */
        .end__roll.is-live .end__prism { animation-play-state: running; }
        .end__roll { cursor: pointer; }
        .end__pos:hover .end__prism, .end__pos:focus-within .end__prism { animation-play-state: paused; }
        .end__face { position: absolute; inset: 0; backface-visibility: hidden; }
        .end__face:nth-child(1) { transform: rotateX(0deg) translateZ(.318em); }
        .end__face:nth-child(2) { transform: rotateX(-120deg) translateZ(.318em); }
        .end__face:nth-child(3) { transform: rotateX(-240deg) translateZ(.318em); }
        @keyframes end-roll {
          0%, 24% { transform: translateZ(-.318em) rotateX(0deg); }
          33.33%, 57.33% { transform: translateZ(-.318em) rotateX(120deg); }
          66.67%, 90.67% { transform: translateZ(-.318em) rotateX(240deg); }
          100% { transform: translateZ(-.318em) rotateX(360deg); }
        }
      }
      .end__h { color: var(--ink-3); font-weight: 400; padding-bottom: 10px; }

      /* The record: one full-width list, one line per engagement, with room to breathe. */
      .end__record ol { border-top: 1px solid var(--rule-strong); }
      .end__entry {
        display: flex;
        align-items: center;
        gap: 16px;
        min-height: 52px;
        padding-block: 12px;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
        white-space: nowrap;
        transition: color 200ms ease;
      }
      .end__idx { flex: none; width: 4ch; color: var(--ink-3); font-size: var(--t-micro); }
      .end__entry-name { font-weight: 500; overflow: hidden; text-overflow: ellipsis; transition: transform 300ms var(--ease-out); }
      .end__entry-co { font-weight: 400; color: var(--ink-3); }
      .end__lead { flex: 1; min-width: 24px; } /* spacer only: the dotted leader was removed (2026-11-06) */
      .end__entry-stat { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
      .end__entry-cap { font-size: var(--t-micro); line-height: 1.2; color: var(--ink-3); text-transform: lowercase; }
      .end__entry-fig { flex: none; font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.9rem); line-height: 1; color: var(--ink-2); }
      @media (hover: hover) {
        .end__entry:hover, .end__entry:hover .end__entry-fig { color: var(--signal); }
        .end__entry:hover .end__entry-name { transform: translateX(4px); }
      }
      .end__entry:focus-visible, .end__entry:focus-visible .end__entry-fig { color: var(--signal); }

      /* Phones: the work groups come first and stack; the brand block (the name is the sign-off right below, the
         mark is in the header) and the external links (the buttons just above) are hidden, so the footer stays no
         longer than before. */
      @media (max-width: 639px) {
        .end__brand { display: none; }
        .end__colophon { row-gap: 18px; }
        .end__record { order: 1; }
        .end__h { padding-bottom: 6px; }
        .end__meta { order: 3; }
        .end__lead { display: none; }
        .end__entry-stat { margin-left: auto; }
        .end__entry-name { white-space: normal; overflow: visible; line-height: 1.25; }
        .end__entry-co { display: block; }
        .end__dot { display: none; }
        .end__entry-cap { text-align: right; }
        .end__entry { min-height: 44px; padding-block: 8px; gap: 10px; }
      }

      .end__meta {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 8px 24px;
        padding-top: 8px;
        /* no rule above the copyright line (2026-11-06) */
        color: var(--ink-3);
      }
      .end__top { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--ink-2); transition: color 200ms ease; }
      .end__top:hover { color: var(--signal); }

      /* Sign-off: "Mick Dubik" in the header's Geist 600, fitted to the content width at every breakpoint, cropped
         by the bottom edge and faded with a mask. Decorative only (aria-hidden). Only transform animates. */
      .end__mark {
        height: 0.74em;
        max-width: none;
        margin: calc(var(--end-gap) / 2) auto 0;
        padding-inline: var(--pad-x);
        font-family: var(--font-sans);
        font-weight: 600;
        /* Round 11: text only, fitted to the content width ("Mick Dubik" in Geist 600 at −0.055em ≈ 4.81em). */
        /* Fitted to the content column (the page width minus the hero margins), not the whole window. */
        font-size: calc((100cqi - 2 * var(--pad-x)) / 4.816);
        line-height: 1;
        letter-spacing: -0.055em;
        white-space: nowrap;
        user-select: none;
        pointer-events: none;
      }
      .end__mark > span {
        display: block;
        color: color-mix(in srgb, var(--ink) 30%, transparent);
        -webkit-mask-image: linear-gradient(to bottom, #000 15%, transparent 92%);
        mask-image: linear-gradient(to bottom, #000 15%, transparent 92%);
      }
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          .end__mark > span {
            animation-name: mark-rise; animation-timing-function: linear; animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 0% entry 100%;
          }
        }
      }
      @keyframes mark-rise {
        from { transform: translateY(40%); }
        to { transform: none; }
      }
    </style>
    {/* Count-up for the key figures ([data-count]): each one counts from 0 to its value the first time it comes
         into view (ease-out, ~1.2s), keeping its prefix and suffix (+, −, %, ×, mo, m+). Width is locked first so
         nothing shifts while digits are added. Inline and at the end of the body so the numbers are set to 0 before
         the first paint (no flash of the final value). Without JS, or with reduced motion, the final value shows. */}
    <script is:inline>
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
        var els = [].slice.call(document.querySelectorAll("[data-count]"));
        var items = [];
        els.forEach(function (el) {
          if (el.children.length) return;
          var text = el.textContent.trim();
          var m = text.match(/^(\D*?)(\d+(?:\.\d+)?)(.*)$/);
          if (!m) return;
          var to = parseFloat(m[2]);
          var dec = (m[2].split(".")[1] || "").length;
          if (getComputedStyle(el).display === "inline") el.style.display = "inline-block";
          el.setAttribute("aria-label", text);
          var item = { el: el, pre: m[1], to: to, dec: dec, post: m[3], text: text, started: false };
          lock(item);
          el.textContent = m[1] + (0).toFixed(dec) + m[3];
          items.push(item);
        });
        // Locks the figure to the width of its final text, measured in the real font. The first pass runs before the web font has loaded, so it runs
        // again once the fonts are ready (and just before the count starts): otherwise the lock is the fallback font's width and the figure, and the
        // text beside it, jumps when the lock is released at the end.
        function lock(it) {
          var cur = it.el.textContent;
          it.el.style.minWidth = "";
          it.el.textContent = it.text;
          it.el.style.minWidth = it.el.getBoundingClientRect().width + "px";
          if (cur !== it.text) it.el.textContent = cur;
        }
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { items.forEach(function (it) { if (!it.started) lock(it); }); });
        }
        function run(it) {
          it.started = true;
          lock(it);
          var start = performance.now(), dur = 1200;
          function frame(now) {
            var t = Math.min(1, (now - start) / dur);
            var eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
            it.el.textContent = it.pre + (it.to * eased).toFixed(it.dec) + it.post;
            if (t < 1) requestAnimationFrame(frame);
            else { it.el.textContent = it.text; it.el.style.minWidth = ""; }
          }
          requestAnimationFrame(frame);
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            var it = items.find(function (x) { return x.el === e.target; });
            if (it) run(it);
          });
        }, { threshold: 0.6 });
        items.forEach(function (it) { io.observe(it.el); });
      })();
    </script>
    <script is:inline>
      (function () {
        var r = document.querySelector("[data-roll]");
        if (!r || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) { r.classList.toggle("is-live", e[0].isIntersecting); }).observe(r);
        var prism = r.querySelector(".end__prism");
        var replay = function () {
          if (!prism || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          prism.style.animation = "none"; void prism.offsetWidth; prism.style.animation = "";
        };
        r.addEventListener("click", replay);
        var b = document.querySelector("[data-roll-replay]"); if (b) b.addEventListener("click", replay);
      })();
    </script>
    <Analytics />
    <ScrollChrome />
  </body>
</html>
