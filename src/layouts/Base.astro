---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { contact, availability, role } from "../data/site";
import Analytics from "../components/Analytics.astro";
import ScrollChrome from "../components/ScrollChrome.astro";
import SiteHeader from "../components/patterns/SiteHeader.astro";
import SiteFooter from "../components/patterns/SiteFooter.astro";
import sansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  /** The footer's closing question: [plain part, italic part]. */
  contactHeading?: [string, string];
  contactSubject?: string;
  /** Keep the page out of search results (the /system reference page). */
  noindex?: boolean;
  /** The header sits transparent at the top of the page and turns into the blurred bar once the page scrolls (every page, 2026-10-23; was home only). */
  heroHeader?: boolean;
  /** Social preview image (1200×630) under /public, e.g. "/og/home.png". */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description = "Mick Dubik, Senior Product Designer for SaaS and AI. Product experiences that scale, convert and retain users, with the numbers to show it.",
  ogType = "website",
  contactHeading = ["Bring me the problem.", "I’ll bring the numbers."],
  contactSubject = "Project enquiry",
  noindex = false,
  heroHeader = true,
  ogImage = "/og/home.png",
  ogImageAlt = "Mick Dubik, Senior Product Designer: the home page, with the name, portrait and role.",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const onHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mick Dubik" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mick Dubik" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Mick Dubik",
      alternateName: "Nikolay Dubik",
      jobTitle: role,
      description: `${role} for SaaS and AI. ${availability}.`,
      email: `mailto:${contact.email}`,
      sameAs: [contact.linkedin],
      knowsAbout: ["Product design", "SaaS", "AI products", "Design systems"],
    })} />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader heroHeader={heroHeader} home={onHome} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter contactHeading={contactHeading} contactSubject={contactSubject} home={onHome} />

    <script>
      // Copy the email address (footer). Both outcomes are announced through the live region.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
        const label = b.querySelector<HTMLElement>("[data-copy-label]")!;
        b.addEventListener("click", async () => {
          const wrap = b.parentElement!;
          const src = wrap.querySelector<HTMLElement>("[data-copy-src]")!;
          const status = wrap.querySelector<HTMLElement>("[data-copy-status]")!;
          const say = (btnText: string, msg: string, ok: boolean) => {
            label.textContent = btnText;
            status.textContent = msg;
            if (ok) b.dataset.state = "copied";
            setTimeout(() => { label.textContent = "Copy"; status.textContent = ""; delete b.dataset.state; }, 2000);
          };
          try {
            await navigator.clipboard.writeText(src.textContent ?? "");
            say("Copied", "Email address copied", true);
          } catch {
            const r = document.createRange();
            r.selectNodeContents(src);
            getSelection()?.removeAllRanges();
            getSelection()?.addRange(r);
            say("Select to copy", "Email address selected. Press Ctrl+C or Command+C to copy.", false);
          }
        });
      });

      // Soft close for <details data-soft-close>: a native details closes instantly, so the content fades out
      // and lifts 6px (150ms) before the row closes. In an exclusive group (name=), the open row closes first,
      // then the new one opens. Reduced motion: native behaviour.
      const softClose = (d: HTMLDetailsElement) => {
        const parts = [...d.children].filter((c) => c.tagName !== "SUMMARY") as HTMLElement[];
        if (!parts.length) { d.open = false; return Promise.resolve(); }
        return Promise.all(
          parts.map((p) => p.animate(
            [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-6px)" }],
            { duration: 150, easing: "cubic-bezier(0.22, 1, 0.36, 1)" }
          ).finished)
        ).then(() => { d.open = false; }).catch(() => { d.open = false; });
      };
      document.querySelectorAll<HTMLDetailsElement>("details[data-soft-close]").forEach((d) => {
        const sum = d.querySelector("summary");
        sum?.addEventListener("click", (e) => {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          e.preventDefault();
          if (d.open) { softClose(d); return; }
          const group = d.getAttribute("name");
          const others = group ? [...document.querySelectorAll<HTMLDetailsElement>(`details[name="${group}"][open]`)].filter((o) => o !== d) : [];
          if (others.length) Promise.all(others.map(softClose)).then(() => { d.open = true; });
          else d.open = true;
        });
      });

      const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      const sync = () => btn?.setAttribute("aria-pressed", String(current() === "dark"));
      sync();
      btn?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.setAttribute("data-theme-fade", "");
          window.setTimeout(() => root.removeAttribute("data-theme-fade"), 260);
        }
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        sync();
      });
    </script>

    {/* Count-up for the key figures ([data-count]): each one counts from 0 to its value the first time it comes
         into view (ease-out, ~1.2s), keeping its prefix and suffix (+, −, %, ×, mo, m+). Width is locked first so
         nothing shifts while digits are added. Inline and at the end of the body so the numbers are set to 0 before
         the first paint (no flash of the final value). Without JS, or with reduced motion, the final value shows. */}
    <script is:inline>
      (function () {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;
        var els = [].slice.call(document.querySelectorAll("[data-count]"));
        var items = [];
        els.forEach(function (el) {
          if (el.children.length) return;
          var text = el.textContent.trim();
          var m = text.match(/^(\D*?)(\d+(?:\.\d+)?)(.*)$/);
          if (!m) return;
          var to = parseFloat(m[2]);
          var dec = (m[2].split(".")[1] || "").length;
          if (getComputedStyle(el).display === "inline") el.style.display = "inline-block";
          el.setAttribute("aria-label", text);
          var item = { el: el, pre: m[1], to: to, dec: dec, post: m[3], text: text, started: false };
          lock(item);
          el.textContent = m[1] + (0).toFixed(dec) + m[3];
          items.push(item);
        });
        // Locks the figure to the width of its final text, measured in the real font. The first pass runs before the web font has loaded, so it runs
        // again once the fonts are ready (and just before the count starts): otherwise the lock is the fallback font's width and the figure, and the
        // text beside it, jumps when the lock is released at the end.
        function lock(it) {
          var cur = it.el.textContent;
          it.el.style.minWidth = "";
          it.el.textContent = it.text;
          it.el.style.minWidth = it.el.getBoundingClientRect().width + "px";
          if (cur !== it.text) it.el.textContent = cur;
        }
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { items.forEach(function (it) { if (!it.started) lock(it); }); });
        }
        function run(it) {
          it.started = true;
          lock(it);
          var start = performance.now(), dur = 1200;
          function frame(now) {
            var t = Math.min(1, (now - start) / dur);
            var eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
            it.el.textContent = it.pre + (it.to * eased).toFixed(it.dec) + it.post;
            if (t < 1) requestAnimationFrame(frame);
            else { it.el.textContent = it.text; it.el.style.minWidth = ""; }
          }
          requestAnimationFrame(frame);
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            var it = items.find(function (x) { return x.el === e.target; });
            if (it) run(it);
          });
        }, { threshold: 0.6 });
        items.forEach(function (it) { io.observe(it.el); });
      })();
    </script>
    <script is:inline>
      (function () {
        var r = document.querySelector("[data-roll]");
        if (!r || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(function (e) { r.classList.toggle("is-live", e[0].isIntersecting); }).observe(r);
        var prism = r.querySelector(".end__prism");
        var replay = function () {
          if (!prism || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          prism.style.animation = "none"; void prism.offsetWidth; prism.style.animation = "";
        };
        r.addEventListener("click", replay);
        var b = document.querySelector("[data-roll-replay]"); if (b) b.addEventListener("click", replay);
      })();
    </script>
    <Analytics />
    <ScrollChrome />
  </body>
</html>
