---
import Base from "../../layouts/Base.astro";
import CaseStudyPage from "../../components/prototypes/CaseStudyPage.astro";
import { caseStudies, type CaseStudy } from "../../data/work";

export function getStaticPaths() {
  return caseStudies.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props { study: CaseStudy }
const { study: c } = Astro.props;
const metricText = (m: { qualifier?: string; value: string; unit: string; label: string }) =>
  `${m.qualifier ? m.qualifier + " " : ""}${m.value}${m.unit} ${m.label.toLowerCase()}`;
---

<Base
  title={`${c.company}: ${c.product} | Mick Dubik case study`}
  description={`${c.dek} ${c.metrics.map(metricText).join(", ")}.`}
  ogType="article"
  ogImage={`/og/${c.slug}.png`}
  ogImageAlt={`${c.company} ${c.product} case study: ${c.headline.qualifier ? c.headline.qualifier + " " : ""}${c.headline.value}${c.headline.unit} ${c.headline.label.toLowerCase()}.`}
  contactHeading={["Want results like these", "on your product?"]}
  contactSubject={`Project enquiry (via ${c.company} ${c.product} case study)`}
>
  <CaseStudyPage study={c} />
</Base>
