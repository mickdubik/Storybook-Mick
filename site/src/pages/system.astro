---
// The design system, as a living reference. Everything here is rendered from the real tokens and components, so
// it cannot drift from the site: colours are read from global.css at build time (and their contrast computed),
// and the component samples are the components themselves. Not linked from the navigation, and noindex.
import css from "../styles/global.css?raw";
import { Picture } from "astro:assets";
import portrait from "../assets/home/portrait-hero.png";
import { availability, role, contact } from "../data/site";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ButtonStates from "../components/ButtonStates.astro";
import Glyph from "../components/Glyph.astro";
import Plate from "../components/Plate.astro";
import Shot from "../components/Shot.astro";
import Avail from "../components/Avail.astro";
import { caseStudies } from "../data/work";
import type { Metric } from "../data/work";

// ---- Tokens, parsed from the stylesheet ----
const cardYear = availability.match(/\d{4}/)?.[0] ?? "";
const grab = (re: RegExp) => {
  const m = css.match(re);
  const out: Record<string, string> = {};
  if (m) for (const t of m[1].matchAll(/--([a-z0-9-]+):\s*(#[0-9a-fA-F]{6})\s*;/g)) out[t[1]] = t[2].toLowerCase();
  return out;
};
const light = grab(/:root\s*\{([\s\S]*?)\n\}/);
const dark = grab(/:root\[data-theme="dark"\]\s*\{([\s\S]*?)\n\}/);

const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ratio = (a: string, b: string) => {
  const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p);
  return (x + 0.05) / (y + 0.05);
};
const grade = (r: number) => (r >= 7 ? "AAA" : r >= 4.5 ? "AA" : r >= 3 ? "AA large" : "Decoration only");

const colors = [
  { name: "paper", role: "Page background" },
  { name: "paper-2", role: "Inset panels: frames, plates, cards" },
  { name: "paper-3", role: "Glyph tracks, wireframe fills" },
  { name: "raised", role: "Raised surfaces: the current-role card (lighter than the page in both themes)" },
  { name: "card", role: "Hero photo card (lighter than the page in light, darker in dark)" },
  { name: "ink", role: "Primary text, primary button" },
  { name: "ink-2", role: "Body and secondary copy" },
  { name: "ink-3", role: "Meta labels" },
  { name: "rule", role: "Hairlines" },
  { name: "signal", role: "Results and interactive states only" },
].filter((c) => light[c.name]);
const textTokens = new Set(["ink", "ink-2", "ink-3", "signal"]);
const rows = colors.map((c) => ({
  ...c,
  text: textTokens.has(c.name),
  l: light[c.name],
  d: dark[c.name] ?? light[c.name],
  lr: ratio(light[c.name], light.paper),
  dr: ratio(dark[c.name] ?? light[c.name], dark.paper ?? light.paper),
}));

// ---- Samples ----
const m = (value: string, unit: string, label: string, kind: Metric["kind"], magnitude: number, direction?: "up" | "down"): Metric => ({ value, unit, label, kind, magnitude, direction });
const glyphs: Metric[] = [
  m("+40", "%", "Courier route efficiency", "percent", 40, "up"),
  m("−60", "%", "Design-to-development handoff", "percent", 60, "down"),
  m("85", "%", "Design system adoption", "share", 85),
  m("2", "×", "Features shipped per sprint", "multiple", 2),
];
const sampleShot = caseStudies[0].cover;

const type = [
  { cls: "display", label: "Display", spec: "Geist, 700, −0.04em", text: "Outcomes first" },
  { cls: "h2", label: "Heading 2", spec: "Geist, 600, −0.035em", text: "The result first. Then how I got there." },
  { cls: "h3", label: "Heading 3", spec: "Geist, 600, −0.02em", text: "Prioritise common use cases" },
];
const scale = [
  ["Hero name", "245 × --unit (about 245px at 1440), Geist 700, −0.04em, uppercase"],
  ["--font-size-display", "2.4 → 6.6rem"],
  ["--font-size-h1", "2.2 → 4.8rem"],
  ["--font-size-h2", "1.9 → 3.6rem"],
  ["--font-size-h3", "1.4 → 1.75rem (22 to 28px)"],
  ["--font-size-figure", "3 → 6.6rem"],
  ["--font-size-figure-sm", "2.2 → 4rem"],
  ["--font-size-lede", "1.3125rem (21px)"],
  ["--font-size-body", "1.0625rem (17px)"],
  ["--font-size-small", "0.875rem (14px)"],
  ["--font-size-label", "0.8125rem (13px): legends, captions, units"],
  ["--font-size-micro", "0.75rem (12px): floor, index marks and tags only"],
];
const spacing = [
  ["--space-gutter", "clamp(16px, 4vw, 56px)", "Page side padding"],
  ["--space-column-gap", "clamp(16px, 2.2vw, 36px)", "Grid column gap"],
  ["--space-section", "clamp(36px, 4.5vw, 64px)", "Section padding: half the gap between unrelated sections (72 to 128px)"],
  ["--space-block / --space-group", "80–96px · 24px", "Between blocks in a chapter · heading to content"],
  ["--space-tile", "8–12px", "Gap between tiles of one grid (persona cards, metric tiles)"],
  ["--size-measure", "31em", "Reading line length (about 66 characters)"],
  ["--size-max", "1920px", "Content width cap; the page uses the hero’s margins on every page"],
  ["--unit-width", "min(100vw, 1920px) / 1440", "Width unit: 1px at a 1440 wide screen"],
  ["--unit", "min(--unit-width, 100svh / 900)", "Hero unit: also capped by the window height so the hero fits one screen"],
  ["--layout-edge / --layout-padding-x", "72 × --unit-width (centred beyond 1920)", "Page margin: header, hero, sections and footer share it"],
  ["--radius-default", "2px", "Base corner radius"],
];
const motion = [
  ["--easing-out", "cubic-bezier(0.22, 1, 0.36, 1)", "Entrances, reveals, counts"],
  ["--duration-default", "420ms", "Standard transition"],
  ["--btn-duration / --btn-easing", "380ms · cubic-bezier(0.25, 0.8, 0.25, 1)", "Button hover sequence"],
  ["Button press", "scale(0.97) · 160ms", "Active state"],
  ["Hero parallax", "name + background 0.1×, card 1.35×, ZiiP result 1.2×, what-I-do 1.1× the page speed", "Scroll, CSS scroll-driven (no JavaScript); pointer drifts only the name (5px, eased 160ms)"],
  ["Hero name fade", "100% → 20% over the first 140u of scroll (when the card reaches the name), then holds", "Opacity, scroll-driven"],
  ["Hero light", "520u soft light, eased 120ms", "Pointer, desktop and fine pointers only"],
];
const rules = [
  ["The Signal Rule", "The accent marks a measured result or an interactive state, and nothing else. It never fills a large area."],
  ["Outcome first", "Every case leads with its reported figure, then the story behind it. Figures come only from the owner’s confirmed facts."],
  ["Hairlines, not boxes", "Sections divide by ruled lines. Surfaces step one tone off the page, never a card shadow."],
  ["Concentric corners", "An inner radius equals the outer radius minus the space between them, so nested shapes look cut from one piece. The hero photo card is the one square exception, by design."],
  ["One family", "Geist carries the message and the work; Geist Mono labels the facts. Emphasis is a second tone, never an italic."],
  ["Transform and opacity only", "Nothing animates width, height, padding or margin. Reduced motion shows the same end states, instantly."],
  ["Honest drawings", "Glyphs and diagrams draw real values only. Illustrative diagrams are titled and say they are illustrative."],
];
---

<Base title="Design system — Mick Dubik" description="The design tokens and components behind this portfolio." noindex>
  <section class="sys">
    <div class="wrap">
      <p class="mono sys__kicker">Design system · reference</p>
      <h1 class="display sys__title">The Outcome <em>Ledger.</em></h1>
      <p class="lede">The tokens, type and components behind this site. Every sample on this page is the live component, and the colours are read from the stylesheet, so it cannot drift from what ships.</p>
      <nav class="sys__toc mono" aria-label="On this page">
        <a href="#principles">Principles</a><a href="#color">Colour</a><a href="#type">Type</a><a href="#space">Space</a><a href="#components">Components</a><a href="#motion">Motion</a><a href="#proposal">Proposal</a><a href="#white">White theme</a>
      </nav>
    </div>
  </section>

  <section class="section sys__sec" id="principles" aria-labelledby="p-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>01</b> Principles</p></div>
      <div class="body">
        <h2 id="p-t" class="h2">Seven rules <em>that decide the rest.</em></h2>
        <dl class="sys__rules">
          {rules.map(([t, d]) => (<div><dt>{t}</dt><dd>{d}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="color" aria-labelledby="c-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>02</b> Colour</p></div>
      <div class="body">
        <h2 id="c-t" class="h2">Warm paper, black ink, <em>one signal.</em></h2>
        <p class="prose sys__lead">Text and signal colours show their contrast against that theme’s page background. Body text needs 4.5:1 (AA); large text 3:1.</p>
        <div class="sys__table" role="table" aria-label="Colour tokens">
          <div class="sys__tr sys__tr--head mono" role="row"><span role="columnheader">Token</span><span role="columnheader">Light</span><span role="columnheader">Dark</span><span role="columnheader">Use</span></div>
          {rows.map((r) => (
            <div class="sys__tr" role="row">
              <span role="cell" class="sys__tok"><code>--{r.name}</code></span>
              <span role="cell" class="sys__sw"><i style={`background:${r.l}`}></i><b>{r.l}</b><small>{r.text ? `${r.lr.toFixed(1)}:1 on paper · ${grade(r.lr)}` : r.name === "rule" ? "Hairline" : "Surface"}</small></span>
              <span role="cell" class="sys__sw"><i style={`background:${r.d}`}></i><b>{r.d}</b><small>{r.text ? `${r.dr.toFixed(1)}:1 on paper · ${grade(r.dr)}` : r.name === "rule" ? "Hairline" : "Surface"}</small></span>
              <span role="cell" class="sys__use">{r.role}</span>
            </div>
          ))}
        </div>
        <p class="sys__note">Surfaces and hairlines are never used for text, so they carry no contrast requirement. Dark theme follows the system setting unless the visitor picks one with the header toggle.</p>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="type" aria-labelledby="t-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>03</b> Type</p></div>
      <div class="body">
        <h2 id="t-t" class="h2">One family for the message, <em>a mono for the labels.</em></h2>
        <div class="sys__type">
          {type.map((t) => (
            <div class="sys__trow">
              <p class="mono sys__meta">{t.label} · {t.spec}</p>
              <p class={t.cls}>{t.text}</p>
            </div>
          ))}
          <div class="sys__trow">
            <p class="mono sys__meta">Figure · Geist, tabular numerals, 600</p>
            <p class="figure-num sys__fig">+40<span>%</span></p>
          </div>
          <div class="sys__trow">
            <p class="mono sys__meta">Body · Geist, 17px, measure 31em (about 66 characters)</p>
            <p class="prose">Led the evolution of the design system across four product designers and twelve front-end engineers, with semantic tokens, reusable components and governance.</p>
          </div>
          <div class="sys__trow">
            <p class="mono sys__meta">Label · Geist Mono, uppercase, +0.04em</p>
            <p class="mono">Senior Product Designer · SaaS and AI</p>
          </div>
        </div>
        <ul class="sys__scale">
          {scale.map(([k, v]) => (<li><code>{k}</code><span>{v}</span></li>))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="space" aria-labelledby="s-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>04</b> Space</p></div>
      <div class="body">
        <h2 id="s-t" class="h2">A 12-column sheet, <em>a rail and a body.</em></h2>
        <p class="prose sys__lead">At 960px and wider the page is 12 columns: the rail (1–3) holds section labels or a table of contents, the body (4–12) holds content. Below that it stacks.</p>
        <div class="sys__grid" aria-hidden="true">
          <span class="sys__rail">Rail · 1–3</span><span class="sys__body">Body · 4–12</span>
        </div>
        <ul class="sys__scale sys__scale--3">
          {spacing.map(([k, v, d]) => (<li><code>{k}</code><span>{v}</span><em>{d}</em></li>))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="components" aria-labelledby="k-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>05</b> Components</p></div>
      <div class="body">
        <h2 id="k-t" class="h2">Small parts, <em>used everywhere.</em></h2>

        <article class="sys__c">
          <h3 class="sys__h">Button</h3>
          <p class="sys__d">Three variants, each in medium (52px tall) and small (44px). Radii are concentric: tile radius = button radius − inset. Size follows the container: small inside cards, logo cells and rows; medium for sections and groups of related actions. Never mix sizes in one row.</p>

          <div class="sys__bgroup">
            <p class="sys__bname mono">Primary</p>
            <p class="sys__d">Solid ink with a paper tile. On hover the tile expands to fill the whole button, so the face turns paper and the label and arrow turn ink. No accent colour.</p>
            <div class="sys__demo btn-row">
              <Button href="#components">Discuss project</Button>
              <Button href="#components" size="sm">Small primary</Button>
            </div>
          </div>

          <div class="sys__bgroup">
            <p class="sys__bname mono">Primary, inverted (header)</p>
            <p class="sys__d">The same behaviour with the colours swapped: paper face, ink tile, 1px ring.</p>
            <div class="sys__demo btn-row">
              <Button href="#components" size="sm" class="btn--inv">Inverted (header)</Button>
            </div>
          </div>

          <div class="sys__bgroup">
            <p class="sys__bname mono">Secondary</p>
            <p class="sys__d">An ink face with the arrow at the end. The face never changes on hover; the arrow takes the other theme’s signal colour (hero card, footer).</p>
            <div class="sys__demo btn-row">
              <Button href="#components" variant="secondary" icon="external">Book a 15-min call</Button>
              <Button href="#components" variant="secondary" size="sm" icon="external">Book a 15-min call</Button>
            </div>
          </div>

          <div class="sys__bgroup">
            <p class="sys__bname mono">Ghost</p>
            <p class="sys__d">A hairline that tints on hover; the arrow takes the signal colour.</p>
            <div class="sys__demo btn-row">
              <Button href="#components" variant="ghost" icon="external">LinkedIn</Button>
              <Button href="#components" variant="ghost" size="sm" icon="down">Small ghost</Button>
            </div>
          </div>

          <div class="sys__bgroup">
            <p class="sys__bname mono">All variants, side by side</p>
            <div class="sys__table sys__table--btn" role="table" aria-label="Button variants and sizes">
              <div class="sys__tr sys__tr--head mono" role="row"><span role="columnheader">Variant</span><span role="columnheader">Medium · 52px</span><span role="columnheader">Small · 44px</span></div>
              <div class="sys__tr" role="row">
                <span role="cell" class="sys__tok"><code>primary</code></span>
                <span role="cell"><Button href="#components">Discuss project</Button></span>
                <span role="cell"><Button href="#components" size="sm">Discuss project</Button></span>
                <span role="cell" class="sys__use">Tile expands, face turns paper. 404 page.</span>
              </div>
              <div class="sys__tr" role="row">
                <span role="cell" class="sys__tok"><code>primary + btn--inv</code></span>
                <span role="cell"><Button href="#components" class="btn--inv">Discuss project</Button></span>
                <span role="cell"><Button href="#components" size="sm" class="btn--inv">Discuss project</Button></span>
                <span role="cell" class="sys__use">Same, colours swapped. Header.</span>
              </div>
              <div class="sys__tr" role="row">
                <span role="cell" class="sys__tok"><code>secondary</code></span>
                <span role="cell"><Button href="#components" variant="secondary" icon="external">Book a 15-min call</Button></span>
                <span role="cell"><Button href="#components" variant="secondary" size="sm" icon="external">Book a 15-min call</Button></span>
                <span role="cell" class="sys__use">Face stays, arrow takes the signal colour. Footer (medium), hero card (small).</span>
              </div>
              <div class="sys__tr" role="row">
                <span role="cell" class="sys__tok"><code>ghost</code></span>
                <span role="cell"><Button href="#components" variant="ghost" icon="external">LinkedIn</Button></span>
                <span role="cell"><Button href="#components" variant="ghost" size="sm" icon="external">LinkedIn</Button></span>
                <span role="cell" class="sys__use">Hairline tints, arrow takes the signal colour. Footer, "Ask me about ZiiP" (medium); logo-cell links, hero card (small).</span>
              </div>
            </div>
          </div>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Hero (home)</h3>
          <p class="sys__d">The first screen is the person. Two lines of the name at headline scale (Geist 700, one size, the D of the second line under the K of the first), a role caption level with the second line, one photo card, one result, and the three working words. Everything is in --unit units and centred between the header and the next section, so it fits one screen from 1440 × 900 down to 1280 × 650 and has equal space above and below. The card is 236px wide, square, hairline, no shadow: darker than the hero in dark, lighter in light; its left edge is the header tabs’ left edge, and it covers about 12% of the name’s letter height. Card rows: a ghost "See case studies" with a down arrow and a secondary "Book a 15-min call". Parallax and the pointer light are listed under Motion.</p>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Hero card</h3>
          <p class="sys__d">The photo card in the home hero: 236px wide, square, hairline, no shadow. Portrait on a square, an availability badge pinned bottom left, name and role, then two full-width rows. The rows are the real small buttons, made flat for the card: square corners, full width, label left and arrow right, a hairline above each. The ghost row keeps its colour on hover (the arrow takes the signal colour); the secondary row keeps its face. Colours, hover, height (44px) and the label roll still come from the button, so a change to the secondary button's colours reaches this row; its radius, padding and ring are the card's own. This sample mirrors the card's styles in <code>index.astro</code> (<code>.hero__card</code>): change both together.</p>
          <div class="sys__demo">
            <aside class="sys__hcard" aria-label="Hero card sample">
              <div class="sys__hphoto">
                <Picture src={portrait} alt="" widths={[284, 568]} sizes="236px" formats={["avif", "webp"]} fallbackFormat="webp" quality={85} loading="lazy" />
                <span class="sys__hbadge"><span>Open to new projects <b>•</b> {cardYear}</span></span>
              </div>
              <div class="sys__hwho"><b>Mick Dubik</b><span>{role}</span></div>
              <Button href="#components" variant="ghost" size="sm" icon="down" class="sys__hask">See case studies</Button>
              <Button href="#components" variant="secondary" size="sm" icon="external" class="sys__hgo">Book a 15-min call</Button>
            </aside>
          </div>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Current-role card</h3>
          <p class="sys__d">A raised surface (lighter than the page in both themes), a "Now" tag whose dot pings twice when it enters view and again on hover, the ZiiP mark flush with the text edge, and four figures with their drawings. Section title: "Shaping the ZiiP product." at weight 800.</p>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Button states</h3>
          <p class="sys__d">The Unbounce design system’s primary button, taken from its Figma component sheet. Default, hover, pressed, loading, done. The size never changes between states.</p>
          <ButtonStates title="One button, every state" caption="The primary button moving through default, hover, pressed and loading. The confirmation is added for the demo." />
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Figure and glyph</h3>
          <p class="sys__d">A reported number in large Geist numerals, with a small honest drawing beside it. Gains extend past a 100% baseline; reductions show the removed share dashed; shares fill a track; multiples are blocks.</p>
          <div class="sys__glyphs">
            {glyphs.map((g) => (
              <div class="sys__g">
                <p class="figure-num sys__gn">{g.value}<span>{g.unit}</span></p>
                <p class="sys__gl">{g.label}</p>
                <Glyph metric={g} />
              </div>
            ))}
          </div>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Tags, links and status</h3>
          <p class="sys__d">Tags are mono pills. Links underline with a hairline that turns signal on hover. The live dot pings while the owner is available.</p>
          <div class="sys__demo sys__demo--row">
            <span class="tags"><span class="tag">SaaS</span><span class="tag">Design Systems</span><span class="tag">AI</span></span>
            <a class="link" href="#components">An inline link</a>
            <span class="mono"><span class="live-dot" aria-hidden="true"></span> <Avail /></span>
          </div>
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Frame</h3>
          <p class="sys__d">One frame for every product image: a theme-aware canvas one step off the page, padding that scales with width, and a 10px inner radius. Frame radius = inner radius + padding.</p>
          <Shot img={sampleShot} sizes="(min-width: 1440px) 900px, 92vw" />
        </article>

        <article class="sys__c">
          <h3 class="sys__h">Plate</h3>
          <p class="sys__d">Explanatory diagrams are drawn in SVG from the case’s own facts, titled, captioned, and marked as illustrative. Text never falls below 12px.</p>
          <Plate variant="tokens" title="How the tokens are layered" caption="Global values feed purpose-driven semantic tokens, with component-level overrides only where needed." />
        </article>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="motion" aria-labelledby="m-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>06</b> Motion</p></div>
      <div class="body">
        <h2 id="m-t" class="h2">Quiet, eased, <em>and optional.</em></h2>
        <p class="prose sys__lead">Only <code>transform</code> and <code>opacity</code> animate. Scroll-driven effects sit behind <code>@supports</code> and show their final state without it. Everything moving is inside <code>prefers-reduced-motion: no-preference</code>.</p>
        <ul class="sys__scale sys__scale--3">
          {motion.map(([k, v, d]) => (<li><code>{k}</code><span>{v}</span><em>{d}</em></li>))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section sys__sec" id="proposal" aria-labelledby="pr-t">
    <div class="wrap sheet">
      <div class="rail"><p class="rail-label"><b>07</b> Proposal</p></div>
      <div class="body">
        <h2 id="pr-t" class="h2">A tighter scale, <em>now live.</em></h2>
        <p class="prose sys__lead">The 22 Oct 2026 audit. All of it is live on the site now: the emphasis grey, the 31em reading measure, the 13px sans legends, the type scale and the spacing tiers. The left side of each pair keeps the earlier values for comparison. Each pair renders the same content with the current values on the left and the proposed ones on the right, scoped to this page. Type specimens are scaled to 80% so the real ratios fit side by side. The proposal: a nine-step type scale (12 · 14 · 17 · 21 · 28 · 40 · 56 · 72 · 160px) with weights 400, 500, 600 and 700, a darker light-mode emphasis grey, 13px sans-serif legends, and three spacing tiers (128 · 64 · 40) on a 4px base.</p>

        <article class="sys__c">
          <h3 class="sys__h">Case-page opening</h3>
          <p class="sys__d">Display 56, lede and statement 21, chapter heading 28, body 17, label 13. Each job gets its own step, so the heading and the sentence under it no longer compete.</p>
          <div class="proto__pair">
            {(["now", "next"] as const).map((v) => (
              <div class={`proto proto--${v}`}>
                <p class="proto__tag mono">{v === "now" ? "Before" : "Now live"}</p>
